index 0000000000000000000000000000000000000000..46a4eb482b1d4d3a44d203ac0c1ed56b67af8c0e
--- /dev/null
+++ b/android_webview/browser/network_service/aw_network_property_policy.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "android_webview/browser/network_service/aw_network_property_policy.h"
+
+#include <algorithm>
+#include <string_view>
+
+#include "base/no_destructor.h"
+#include "net/base/proxy_string_util.h"
+#include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
+#include "third_party/blink/public/common/webview/property_overrides.h"
+
+namespace android_webview {
+
+const AwNetworkPropertyPolicy& AwNetworkPropertyPolicy::Get() {
+  static const base::NoDestructor<AwNetworkPropertyPolicy> policy(
+      blink::WebViewPropertyOverrides().NetworkProxy());
+  return *policy;
+}
+
+AwNetworkPropertyPolicy::AwNetworkPropertyPolicy(
+    std::optional<std::string> proxy_uri) {
+  if (!proxy_uri) {
+    return;
+  }
+
+  auto& rules = proxy_config_.emplace().proxy_rules();
+  rules.type = net::ProxyConfig::ProxyRules::Type::PROXY_LIST;
+  // In pinned proxy mode, even loopback/link-local URLs must not silently
+  // bypass the proxy. There are no bypass rules or DIRECT fallback entries.
+  rules.bypass_rules.AddRulesToSubtractImplicit();
+  proxy_is_valid_ = false;
+
+  const std::string_view uri = *proxy_uri;
+  if (!uri.starts_with("http://") && !uri.starts_with("https://") &&
+      !uri.starts_with("socks5://")) {
+    return;
+  }
+  const auto authority = uri.substr(uri.find("://") + 3);
+  if (authority.empty() ||
+      authority.find_first_of("/@?#\\,;=") != std::string_view::npos ||
+      !std::all_of(authority.begin(), authority.end(),
+                   [](unsigned char c) { return c > 32 && c < 127; })) {
+    return;
+  }
+
+  // Use Chromium's native parser for hostname, IPv6 and port validation.
+  net::ProxyChain chain =
+      net::ProxyUriToProxyChain(uri, net::ProxyServer::SCHEME_HTTP);
+  if (!chain.is_single_proxy() || chain.First().host_port_pair().port() == 0) {
+    return;
+  }
+  rules.single_proxies.SetSingleProxyChain(chain);
+  proxy_is_valid_ = true;
+}
+
+AwNetworkPropertyPolicy::~AwNetworkPropertyPolicy() = default;
+
+bool AwNetworkPropertyPolicy::ApplyWebRtcPolicy(
+    blink::RendererPreferences& prefs) const {
+  if (!proxy_config_) {
+    return false;
+  }
+  constexpr auto policy =
+      blink::mojom::WebRtcIpHandlingPolicy::kDisableNonProxiedUdp;
+  const bool changed = prefs.webrtc_ip_handling_policy != policy ||
+                       !prefs.webrtc_ip_handling_urls.empty();
+  prefs.webrtc_ip_handling_policy = policy;
+  // Per-origin exceptions must not relax the selected proxy's routing policy.
+  prefs.webrtc_ip_handling_urls.clear();
+  return changed;
+}
+
+}  // namespace android_webview
diff --git a/android_webview/browser/network_service/aw_network_property_policy.h b/android_webview/browser/network_service/aw_network_property_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..2b867b2d40b425714f986ddcfb7fd93d297d596d
--- /dev/null
+++ b/android_webview/browser/network_service/aw_network_property_policy.h
@@ -0,0 +1,44 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ANDROID_WEBVIEW_BROWSER_NETWORK_SERVICE_AW_NETWORK_PROPERTY_POLICY_H_
+#define ANDROID_WEBVIEW_BROWSER_NETWORK_SERVICE_AW_NETWORK_PROPERTY_POLICY_H_
+
+#include <optional>
+#include <string>
+
+#include "net/proxy_resolution/proxy_config.h"
+
+namespace blink {
+struct RendererPreferences;
+}
+
+namespace android_webview {
+
+// Browser-process startup policy shared by every WebView NetworkContext and
+// renderer preference update. Changing it requires restarting the host app.
+class AwNetworkPropertyPolicy {
+ public:
+  static const AwNetworkPropertyPolicy& Get();
+
+  // nullopt keeps native networking. A configured but invalid endpoint creates
+  // an empty PROXY_LIST, so requests fail instead of falling back to DIRECT.
+  explicit AwNetworkPropertyPolicy(std::optional<std::string> proxy_uri);
+  ~AwNetworkPropertyPolicy();
+
+  const std::optional<net::ProxyConfig>& proxy_config() const {
+    return proxy_config_;
+  }
+  bool proxy_is_valid() const { return proxy_is_valid_; }
+  bool ApplyWebRtcPolicy(blink::RendererPreferences& prefs) const;
+  bool ShouldBlockWebTransport() const { return proxy_config_.has_value(); }
+
+ private:
+  std::optional<net::ProxyConfig> proxy_config_;
+  bool proxy_is_valid_ = true;
+};
+
+}  // namespace android_webview
+
+#endif  // ANDROID_WEBVIEW_BROWSER_NETWORK_SERVICE_AW_NETWORK_PROPERTY_POLICY_H_

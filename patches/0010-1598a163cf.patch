+void AwContentBrowserClient::WillCreateWebTransport(
+    int process_id,
+    int frame_routing_id,
+    const GURL& url,
+    const url::Origin& initiator_origin,
+    mojo::PendingRemote<network::mojom::WebTransportHandshakeClient>
+        handshake_client,
+    WillCreateWebTransportCallback callback) {
+  if (AwNetworkPropertyPolicy::Get().ShouldBlockWebTransport()) {
+    auto error = network::mojom::WebTransportError::New();
+    error->net_error = net::ERR_BLOCKED_BY_CLIENT;
+    error->details =
+        "WebTransport is unavailable with a configured WebView proxy.";
+    error->safe_to_report_details = true;
+    std::move(callback).Run(std::move(handshake_client), std::move(error));
+    return;
+  }
+  content::ContentBrowserClient::WillCreateWebTransport(
+      process_id, frame_routing_id, url, initiator_origin,
+      std::move(handshake_client), std::move(callback));
+}

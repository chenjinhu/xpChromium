@@ -0,0 +1,108 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "android_webview/browser/network_service/aw_network_property_policy.h"
+
+#include "mojo/public/cpp/test_support/test_utils.h"
+#include "net/base/net_errors.h"
+#include "net/log/net_log_with_source.h"
+#include "net/proxy_resolution/proxy_config_with_annotation.h"
+#include "net/proxy_resolution/proxy_info.h"
+#include "net/traffic_annotation/network_traffic_annotation_test_helper.h"
+#include "services/network/public/cpp/proxy_config_mojom_traits.h"
+#include "services/network/public/mojom/proxy_config_with_annotation.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
+#include "url/gurl.h"
+
+namespace android_webview {
+namespace {
+
+TEST(AwNetworkPropertyPolicyTest, NativePreservesPreferences) {
+  AwNetworkPropertyPolicy policy(std::nullopt);
+  EXPECT_FALSE(policy.proxy_config());
+  EXPECT_FALSE(policy.ShouldBlockWebTransport());
+  blink::RendererPreferences prefs;
+  prefs.webrtc_ip_handling_policy =
+      blink::mojom::WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly;
+  EXPECT_FALSE(policy.ApplyWebRtcPolicy(prefs));
+  EXPECT_EQ(prefs.webrtc_ip_handling_policy,
+            blink::mojom::WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly);
+}
+
+TEST(AwNetworkPropertyPolicyTest, RoutesAllProtocolsAndLoopback) {
+  for (const char* endpoint :
+       {"http://192.0.2.1:7890", "https://proxy.example:443",
+        "socks5://[2001:db8::1]:1080"}) {
+    SCOPED_TRACE(endpoint);
+    AwNetworkPropertyPolicy policy(endpoint);
+    ASSERT_TRUE(policy.proxy_is_valid());
+    ASSERT_TRUE(policy.proxy_config());
+    for (const char* url :
+         {"http://example.test/", "https://example.test/", "ws://example.test/",
+          "wss://example.test/", "http://127.0.0.1/", "http://[::1]/",
+          "http://169.254.1.2/"}) {
+      SCOPED_TRACE(url);
+      net::ProxyInfo info;
+      policy.proxy_config()->proxy_rules().Apply(GURL(url), &info);
+      ASSERT_FALSE(info.is_empty());
+      EXPECT_FALSE(info.is_direct());
+      EXPECT_EQ(info.proxy_chain().length(), 1u);
+      EXPECT_EQ(info.proxy_list().size(), 1u);
+      EXPECT_FALSE(info.Fallback(net::ERR_PROXY_CONNECTION_FAILED,
+                                 net::NetLogWithSource()));
+      EXPECT_TRUE(info.is_empty());
+    }
+  }
+}
+
+TEST(AwNetworkPropertyPolicyTest, InvalidConfigurationNeverBecomesDirect) {
+  for (const char* endpoint :
+       {"direct://", "proxy.example:7890", "socks4://proxy.example:1080",
+        "http://user:password@proxy.example:7890", "http://proxy.example/path",
+        "http://proxy.example:7890,direct://", "http=proxy.example:7890",
+        "http://proxy.example:0", "http://proxy.example:99999",
+        "http://proxy.example:no", "http://proxy.example:7890\n", "http://",
+        "http://proxy.example?query", "http://proxy.example#ref"}) {
+    SCOPED_TRACE(endpoint);
+    AwNetworkPropertyPolicy policy(endpoint);
+    ASSERT_TRUE(policy.proxy_config());
+    EXPECT_FALSE(policy.proxy_is_valid());
+    EXPECT_TRUE(policy.ShouldBlockWebTransport());
+    for (const char* url : {"https://example.test/", "http://localhost/"}) {
+      net::ProxyInfo info;
+      policy.proxy_config()->proxy_rules().Apply(GURL(url), &info);
+      EXPECT_TRUE(info.is_empty());
+    }
+  }
+}
+
+TEST(AwNetworkPropertyPolicyTest, ProxyRestrictsWebRtcAndRemovesExceptions) {
+  AwNetworkPropertyPolicy policy("http://192.0.2.1:7890");
+  blink::RendererPreferences prefs;
+  prefs.webrtc_ip_handling_urls.emplace_back();
+  EXPECT_TRUE(policy.ApplyWebRtcPolicy(prefs));
+  EXPECT_EQ(prefs.webrtc_ip_handling_policy,
+            blink::mojom::WebRtcIpHandlingPolicy::kDisableNonProxiedUdp);
+  EXPECT_TRUE(prefs.webrtc_ip_handling_urls.empty());
+  EXPECT_FALSE(policy.ApplyWebRtcPolicy(prefs));
+  EXPECT_TRUE(policy.ShouldBlockWebTransport());
+}
+
+TEST(AwNetworkPropertyPolicyTest, MojoPreservesBlockedProxyConfiguration) {
+  AwNetworkPropertyPolicy policy("invalid");
+  net::ProxyConfigWithAnnotation input(*policy.proxy_config(),
+                                       TRAFFIC_ANNOTATION_FOR_TESTS);
+  net::ProxyConfigWithAnnotation output;
+  ASSERT_TRUE(mojo::test::SerializeAndDeserialize<
+              network::mojom::ProxyConfigWithAnnotation>(input, output));
+  for (const char* url : {"https://example.test/", "http://localhost/"}) {
+    net::ProxyInfo info;
+    output.value().proxy_rules().Apply(GURL(url), &info);
+    EXPECT_TRUE(info.is_empty());
+  }
+}
+
+}  // namespace
+}  // namespace android_webview

+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Check actual default-UA construction and proxy/ICE compatibility gates."""
+from pathlib import Path
+import subprocess
+from test_support import definition, host_build
+
+source_root = Path(__file__).resolve().parents[1]
+code = (source_root / 'webview_custom/tests/network_identity_test.cc').read_text()
+ua = definition(source_root,
+                'android_webview/browser/aw_content_browser_client.cc',
+                'std::string GetUserAgent() {')
+code = code.replace('PRODUCTION_DEFAULT_UA', ua)
+policy_path = 'android_webview/browser/network_service/aw_network_property_policy.cc'
+policy = '\n'.join(definition(source_root, policy_path, signature) for signature in (
+    'AwNetworkPropertyPolicy::AwNetworkPropertyPolicy(',
+    'bool AwNetworkPropertyPolicy::ApplyWebRtcPolicy('))
+code = code.replace('PRODUCTION_NETWORK_POLICY', policy)
+with host_build(source_root, code) as executable:
+    subprocess.run([str(executable)], check=True)
+print('PASS: default UA, proxy policy assembly, WebRTC preferences and ICE gates (ASan/UBSan)')
diff --git a/webview_custom/tests/network_identity_test.cc b/webview_custom/tests/network_identity_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..48ba2c9b7aeb6b65f6a83cf2791688de3434a85a
--- /dev/null
+++ b/webview_custom/tests/network_identity_test.cc
@@ -0,0 +1,179 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <sys/system_properties.h>
+
+#include <algorithm>
+#include <cassert>
+#include <string>
+
+#include "third_party/blink/public/common/webview/property_overrides.h"
+
+// Native net parsing/routing is covered by aw_network_property_policy_unittest.
+// These adapters only check the production policy's decisions at that boundary.
+namespace net {
+struct ProxyServer {
+  enum Scheme { SCHEME_HTTP };
+  struct Endpoint {
+    int value;
+    int port() const { return value; }
+  } endpoint;
+  const Endpoint& host_port_pair() const { return endpoint; }
+};
+struct ProxyChain {
+  bool single;
+  ProxyServer server;
+  bool is_single_proxy() const { return single; }
+  const ProxyServer& First() const { return server; }
+};
+inline bool parser_accepts = true;
+inline int parsed_port = 7890;
+inline int parse_calls = 0;
+ProxyChain ProxyUriToProxyChain(std::string_view, ProxyServer::Scheme) {
+  ++parse_calls;
+  return {parser_accepts, {{parsed_port}}};
+}
+struct ProxyConfig {
+  struct ProxyRules {
+    enum class Type { EMPTY, PROXY_LIST };
+    struct Bypass {
+      bool subtract_implicit = false;
+      void AddRulesToSubtractImplicit() { subtract_implicit = true; }
+    } bypass_rules;
+    struct List {
+      bool has_proxy = false;
+      void SetSingleProxyChain(const ProxyChain&) { has_proxy = true; }
+    } single_proxies;
+    Type type = Type::EMPTY;
+  } rules;
+  ProxyRules& proxy_rules() { return rules; }
+  const ProxyRules& proxy_rules() const { return rules; }
+};
+}  // namespace net
+namespace blink {
+namespace mojom {
+enum class WebRtcIpHandlingPolicy { kDefault, kDisableNonProxiedUdp };
+}
+struct RendererPreferences {
+  mojom::WebRtcIpHandlingPolicy webrtc_ip_handling_policy =
+      mojom::WebRtcIpHandlingPolicy::kDefault;
+  std::vector<int> webrtc_ip_handling_urls;
+};
+}  // namespace blink
+
+void set(const char* name, const char* value) {
+  props[name] = {name, value};
+}
+namespace base {
+struct CommandLine {
+  static CommandLine* ForCurrentProcess() {
+    static CommandLine line;
+    return &line;
+  }
+  bool HasSwitch(const char*) const { return false; }
+};
+}  // namespace base
+namespace embedder_support {
+constexpr char kUseMobileUserAgent[] = "mobile";
+enum class IncludeAndroidBuildNumber { Include };
+std::string BuildUserAgentFromOSAndProduct(const char*, const std::string&) {
+  return "native";
+}
+std::string BuildUserAgentFromProductAndExtraOSInfo(const std::string&,
+                                                    const char*,
+                                                    IncludeAndroidBuildNumber) {
+  return "native";
+}
+}  // namespace embedder_support
+namespace android_webview {
+struct AwNetworkPropertyPolicy {
+  explicit AwNetworkPropertyPolicy(std::optional<std::string>);
+  bool ApplyWebRtcPolicy(blink::RendererPreferences&) const;
+  std::optional<net::ProxyConfig> proxy_config_;
+  bool proxy_is_valid_ = true;
+};
+PRODUCTION_NETWORK_POLICY
+namespace switches {
+constexpr char kWebViewReduceUAAndroidVersionDeviceModel[] = "reduce";
+}
+std::string GetProduct() {
+  return "Chromium/158";
+}
+PRODUCTION_DEFAULT_UA
+}  // namespace android_webview
+
+int main() {
+  using android_webview::AwNetworkPropertyPolicy;
+  using blink::WebViewPropertyOverrides;
+  AwNetworkPropertyPolicy native(std::nullopt);
+  assert(!native.proxy_config_);
+  blink::RendererPreferences prefs;
+  assert(!native.ApplyWebRtcPolicy(prefs));
+  for (const char* endpoint :
+       {"http://192.0.2.1:7890", "https://proxy.example:443",
+        "socks5://[2001:db8::1]:1080"}) {
+    AwNetworkPropertyPolicy policy(endpoint);
+    assert(policy.proxy_config_ && policy.proxy_is_valid_);
+    const auto& rules = policy.proxy_config_->proxy_rules();
+    assert(rules.type == net::ProxyConfig::ProxyRules::Type::PROXY_LIST);
+    assert(rules.single_proxies.has_proxy &&
+           rules.bypass_rules.subtract_implicit);
+    prefs.webrtc_ip_handling_urls.push_back(1);
+    assert(policy.ApplyWebRtcPolicy(prefs));
+    assert(prefs.webrtc_ip_handling_policy ==
+           blink::mojom::WebRtcIpHandlingPolicy::kDisableNonProxiedUdp);
+    assert(prefs.webrtc_ip_handling_urls.empty());
+    assert(!policy.ApplyWebRtcPolicy(prefs));
+  }
+  for (const char* invalid :
+       {"direct://", "http://user:pass@proxy:7890", "http://proxy/path",
+        "http://proxy:80,direct://", "http://proxy:80;https=direct://",
+        "http://proxy:80\n"}) {
+    int before = net::parse_calls;
+    AwNetworkPropertyPolicy policy(invalid);
+    assert(policy.proxy_config_ && !policy.proxy_is_valid_);
+    assert(!policy.proxy_config_->proxy_rules().single_proxies.has_proxy);
+    assert(policy.proxy_config_->proxy_rules().bypass_rules.subtract_implicit);
+    assert(net::parse_calls == before);
+  }
+  net::parser_accepts = false;
+  AwNetworkPropertyPolicy rejected("http://proxy:bad");
+  assert(rejected.proxy_config_ && !rejected.proxy_is_valid_);
+  net::parser_accepts = true;
+  net::parsed_port = 0;
+  AwNetworkPropertyPolicy zero_port("http://proxy:0");
+  assert(zero_port.proxy_config_ && !zero_port.proxy_is_valid_);
+  assert(android_webview::GetUserAgent() == "native");
+  set("chromium.enable", "1");
+  set("chromium.navigator.useragent", "Mozilla/5.0 ");
+  set("chromium.navigator.useragent2", "configured ");
+  set("chromium.navigator.useragent3", "WebView");
+  assert(android_webview::GetUserAgent() == "Mozilla/5.0 configured WebView");
+  set("chromium.navigator.useragent2", "bad\r\nInjected: yes");
+  assert(android_webview::GetUserAgent() == "native");
+  set("chromium.network.proxy", "http://192.0.2.1:7890");
+  assert(WebViewPropertyOverrides().NetworkProxy() == "http://192.0.2.1:7890");
+  set("chromium.webrtc.public_ip", "203.0.113.5");
+  set("chromium.webrtc.private_ip", "192.168.2.10");
+  set("chromium.webrtc.sdp_redact", "1");
+  const std::string candidate = "candidate:1 1 udp 1 10.0.0.1 4567 typ host";
+  const std::string sdp = "v=0\r\na=" + candidate + "\r\n";
+  assert(!WebViewPropertyOverrides().IceAddress("host"));
+  assert(WebViewPropertyOverrides().IceCandidate(candidate) == candidate);
+  assert(WebViewPropertyOverrides().RedactSdp(sdp) == sdp);
+  // An invalid nonempty proxy remains an explicit selection: the browser
+  // blocks traffic rather than treating it as a request to restore native mode.
+  set("chromium.network.proxy", "invalid");
+  assert(WebViewPropertyOverrides().NetworkProxy() == "invalid");
+  assert(WebViewPropertyOverrides().IceCandidate(candidate) == candidate);
+  set("chromium.network.proxy", "-");
+  assert(!WebViewPropertyOverrides().NetworkProxy());
+  assert(WebViewPropertyOverrides().IceCandidate(candidate) != candidate);
+  set("chromium.network.proxy", "");
+  assert(!WebViewPropertyOverrides().NetworkProxy());
+  set("chromium.network.proxy", "http://192.0.2.1:7890");
+  set("chromium.enable", "0");
+  assert(!WebViewPropertyOverrides().NetworkProxy());
+  assert(android_webview::GetUserAgent() == "native");
+}

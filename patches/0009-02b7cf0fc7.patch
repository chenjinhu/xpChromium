+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Exercise actual production method bodies with lightweight boundary adapters.
+
+The adapters do not test PNG codecs or V8. Android compilation verifies those
+real types; a device is still required for end-to-end WebView testing.
+"""
+from pathlib import Path
+import subprocess
+from test_support import definition, host_build
+
+source_root=Path(__file__).resolve().parents[1]
+code=(source_root/'webview_custom/tests/review_regressions.cc').read_text()
+methods={
+    'PRODUCTION_METADATA': [('third_party/blink/common/user_agent/user_agent_metadata.cc','void ApplyUserAgentPropertyOverrides(')],
+    'PRODUCTION_AUDIO': [('third_party/blink/renderer/modules/webaudio/audio_buffer.cc','void AudioBuffer::MaybeApplyPropertyNoise('),('third_party/blink/renderer/modules/webaudio/audio_buffer.cc','NotShared<DOMFloat32Array> AudioBuffer::getChannelData(unsigned'),('third_party/blink/renderer/modules/webaudio/audio_buffer.cc','void AudioBuffer::Zero()')],
+    'PRODUCTION_CANVAS': [('third_party/blink/renderer/platform/graphics/image_data_buffer.cc','String ImageDataBuffer::ToDataURL(')],
+}
+for key,items in methods.items():
+    code=code.replace(key,'\n'.join(definition(source_root,path,signature) for path,signature in items))
+cases=['ipv4-canonical','ice-whitespace','ice-invalid-prefix','metadata-invalid-ascii',
+       'metadata-one-enable-read','audio-native-read','audio-zero-reuse','canvas-other-row','canvas-transparent-copy']
+with host_build(source_root,code) as executable:
+    for case in cases:
+        subprocess.run([str(executable),case],check=True)
+        print('PASS '+case)

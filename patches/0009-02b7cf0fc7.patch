@@ -0,0 +1,97 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+
+#include "third_party/blink/public/common/webview/property_overrides.h"
+#include <sys/system_properties.h>
+#include <array>
+#include <cmath>
+#include <algorithm>
+#include <cassert>
+#include <span>
+#include <limits>
+using namespace blink::webview;
+using blink::WebViewPropertyOverrides;
+void set(const char* name, const char* value) { props[name] = {name,value}; }
+namespace network {
+struct HttpRequestHeadersUpdateParams {
+  std::vector<std::string> operations;
+  void RemoveHeader(std::string_view key) { operations.push_back("remove:"+std::string(key)); }
+  void SetCorsExemptHeader(std::string_view key,std::string_view value) { operations.push_back("cors:"+std::string(key)+"="+std::string(value)); }
+  void SetHeader(std::string_view key,std::string_view value) { operations.push_back("set:"+std::string(key)+"="+std::string(value)); }
+};
+}
+namespace net { struct HttpRequestHeaders { static constexpr char kUserAgent[]="User-Agent"; }; }
+namespace content { std::string GetCorsExemptRequestedWithHeaderName(){return "X-Requested-With";} }
+namespace android_webview {
+struct AwProxyingURLLoaderFactory {
+ static void ApplyPropertyHeaderOverrides(network::HttpRequestHeadersUpdateParams&);
+};
+PRODUCTION_HEADER_POLICY
+}
+using HeaderUpdates=network::HttpRequestHeadersUpdateParams;
+using android_webview::AwProxyingURLLoaderFactory;
+int main() {
+  assert(!WebViewPropertyOverrides().enabled()); assert(!WebViewPropertyOverrides().RequestedWith());
+  set("chromium.config.x_requested_with","replacement");
+  assert(!WebViewPropertyOverrides().RequestedWith());
+  set("chromium.enable","1"); assert(WebViewPropertyOverrides().RequestedWith() == "replacement");
+  HeaderUpdates replacement; AwProxyingURLLoaderFactory::ApplyPropertyHeaderOverrides(replacement);
+  assert((replacement.operations==std::vector<std::string>{"remove:X-Requested-With","cors:X-Requested-With=replacement"}));
+  set("chromium.config.x_requested_with",""); assert(WebViewPropertyOverrides().RequestedWith() == "");
+  HeaderUpdates removal; AwProxyingURLLoaderFactory::ApplyPropertyHeaderOverrides(removal);
+  assert((removal.operations==std::vector<std::string>{"remove:X-Requested-With"}));
+  set("chromium.config.x_requested_with","-"); assert(!WebViewPropertyOverrides().RequestedWith());
+  set("chromium.config.x_requested_with","bad\r\nInjected: yes");
+  assert(!WebViewPropertyOverrides().RequestedWith());
+  props.erase("chromium.config.x_requested_with"); assert(!WebViewPropertyOverrides().RequestedWith());
+  for (const char* invalid : {"NaN","inf","-1","999999999999999999999","12x"," 12"}) {
+    set("number",invalid); assert(!WebViewPropertyOverrides().GetInt("number",0,100));
+    assert(!WebViewPropertyOverrides().GetDouble("number",0,100));
+  }
+  set("number","12"); assert(WebViewPropertyOverrides().GetInt("number",0,100)==12);
+  set("number","0.5"); assert(WebViewPropertyOverrides().GetDouble("number",0,1)==0.5);
+  set("boolean","0"); assert(WebViewPropertyOverrides().GetBool("boolean")==false);
+  set("boolean","true"); assert(WebViewPropertyOverrides().GetBool("boolean")==true);
+  set("boolean","nope"); assert(!WebViewPropertyOverrides().GetBool("boolean"));
+  set("chromium.navigator.useragent","Mozilla/");
+  set("chromium.navigator.useragent2","5.0 ");
+  set("chromium.navigator.useragent3","test"); assert(WebViewPropertyOverrides().UserAgent()=="Mozilla/5.0 test");
+  set("chromium.navigator.useragent2","\nbad"); assert(!WebViewPropertyOverrides().UserAgent());
+  set("brands","A,158&B,1"); assert(WebViewPropertyOverrides().Brands("brands").size()==2);
+  for (const char* invalid : {"broken","A,1&","A,1&B","A,1,2",",1","\xC3\xA9,1"}) {
+    set("brands",invalid); assert(WebViewPropertyOverrides().Brands("brands").empty());
+  }
+  assert(IsIPv4("192.0.2.7")); assert(!IsIPv4("999.0.0.1"));
+  assert(!IsIPv4("1.2.3")); assert(!IsIPv4("1.2.3.4.5"));
+  set("chromium.webrtc.public_ip","203.0.113.5");
+  set("chromium.webrtc.private_ip","192.168.2.10");
+  auto srflx = WebViewPropertyOverrides().IceCandidate("candidate:1 1 udp 1 198.51.100.7 4567 typ srflx raddr 10.0.0.1 rport 1234");
+  assert(srflx=="candidate:1 1 udp 1 203.0.113.5 4567 typ srflx raddr 192.168.2.10 rport 1234");
+  assert(WebViewPropertyOverrides().IceCandidate("candidate:2 1 udp 1 abc.local 1 typ host")=="candidate:2 1 udp 1 abc.local 1 typ host");
+  assert(WebViewPropertyOverrides().IceCandidate("")=="");
+  std::string sdp="v=0\r\nc=IN IP4 198.51.100.7\r\na=candidate:1 1 udp 1 10.0.0.1 5 typ host\r\nm=audio 9 UDP 1\r\n";
+  assert(WebViewPropertyOverrides().RedactSdp(sdp)==sdp);
+  set("chromium.webrtc.sdp_redact","1");
+  assert(WebViewPropertyOverrides().RedactSdp(sdp)=="v=0\r\nc=IN IP4 0.0.0.0\r\nm=audio 9 UDP 1\r\n");
+  std::array<float,4> data={0,0.1f,-0.2f,std::numeric_limits<float>::infinity()};
+  assert(PerturbAudio(std::span(data),10));
+  assert(data[0]==0 && std::abs(data[1]-0.10001f)<1e-7f);
+  assert(std::isinf(data[3]));
+  std::array<float,4> silence={}; assert(!PerturbAudio(std::span(silence),1));
+  set("chromium.enable","0"); assert(!WebViewPropertyOverrides().GetInt("number",0,100));
+  assert(WebViewPropertyOverrides().IceCandidate("candidate:3 1 udp 1 10.0.0.1 5 typ host ")=="candidate:3 1 udp 1 10.0.0.1 5 typ host ");
+  assert(WebViewPropertyOverrides().RedactSdp(sdp)==sdp);
+
+  std::array<uint8_t,16> pixels={10,20,30,255, 99,99,99,255, 1,2,3,255, 99,99,99,255};
+  auto selected=CanvasNoiseByteIndex(pixels,1,2,8,1);
+  assert(selected && (*selected==0 || *selected==8));
+  assert(selected==CanvasNoiseByteIndex(pixels,1,2,8,1));
+  assert(!CanvasNoiseByteIndex(pixels,0,2,8,1));
+  assert(!CanvasNoiseByteIndex(pixels,2,3,8,1));
+  assert(!CanvasNoiseByteIndex(pixels,1,2,3,1));
+  assert(!CanvasNoiseByteIndex(pixels,1,2,8,0));
+  assert(!CanvasNoiseByteIndex(pixels,1,2,8,std::numeric_limits<double>::infinity()));
+  assert(!CanvasNoiseByteIndex(std::span<const uint8_t>(pixels).first(8),1,2,8,1));
+}
diff --git a/webview_custom/tests/review_regressions.cc b/webview_custom/tests/review_regressions.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d7de07dfd35285953fa00c0ef2547c8f9925e40e
--- /dev/null
+++ b/webview_custom/tests/review_regressions.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/webview/property_overrides.h"
+#include <sys/system_properties.h>
+#include <array>
+#include <cmath>
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+#define DCHECK assert
+void Set(const char* key, const char* value) { props[key]={key,value}; }
+
+// Small boundary adapters; method implementations below come from production.
+
+namespace blink {
+struct UserAgentBrandVersion {
+  std::string brand,version;
+  UserAgentBrandVersion(std::string a,std::string b):brand(a),version(b){}
+};
+struct UserAgentMetadata {
+  std::vector<UserAgentBrandVersion> brand_version_list,brand_full_version_list;
+  bool mobile=false,wow64=false;
+  std::string platform="Android",platform_version="14",architecture="arm",
+      model="Pixel",full_version="158.0.8109.0",bitness="64";
+};
+PRODUCTION_METADATA
+
+struct DOMFloat32Array {
+  std::array<float,32> data;
+  DOMFloat32Array() { data.fill(0.25f); }
+  std::span<float> AsSpan() { return data; }
+};
+template<class T> struct NotShared {
+  T* value;
+  explicit NotShared(T* p):value(p){}
+  T* operator->()const {return value;}
+  explicit operator bool() const {return value != nullptr;}
+};
+struct Channel {
+  DOMFloat32Array value;
+  DOMFloat32Array* Get() {return &value;}
+  DOMFloat32Array* operator->(){return Get();}
+};
+struct AudioBuffer {
+  std::vector<Channel> channels_{1};
+  std::vector<uint8_t> property_noise_applied_{0};
+  void MaybeApplyPropertyNoise(unsigned channel_index);
+  void Zero();
+  NotShared<DOMFloat32Array> getChannelData(unsigned channel_index);
+};
+PRODUCTION_AUDIO
+
+using String=std::string;
+template<class T> using Vector=std::vector<T>;
+template<class T> using sk_sp=std::shared_ptr<T>;
+enum SkColorType {kRGBA_8888_SkColorType,kBGRA_8888_SkColorType};
+struct Info {int width,height;SkColorType type=kRGBA_8888_SkColorType;};
+struct SkData {
+  std::vector<uint8_t> data;
+  void* writable_data(){return data.data();}
+};
+struct SkPixmap {
+  Info information;
+  uint8_t* pointer;
+  size_t stride;
+  SkPixmap(Info i,void* p,size_t s):information(i),pointer(static_cast<uint8_t*>(p)),stride(s){}
+  int width() const{return information.width;}
+  int height() const{return information.height;}
+  SkColorType colorType()const{return information.type;}
+  Info info()const{return information;}
+  size_t rowBytes()const{return stride;}
+};
+inline int copies=0;
+namespace gfx {
+std::span<const uint8_t> SkPixmapToSpan(const SkPixmap& p){return {p.pointer,p.stride*static_cast<size_t>(p.height())};}
+std::span<uint8_t> SkPixmapToWritableSpan(const SkPixmap& p){return {p.pointer,p.stride*static_cast<size_t>(p.height())};}
+sk_sp<SkData> MakeSkDataFromSpanWithCopy(std::span<const uint8_t> bytes){
+  ++copies;auto p=std::make_shared<SkData>();p->data.assign(bytes.begin(),bytes.end());return p;
+}
+}
+enum class ImageEncodingMimeType {kPNG};
+inline std::vector<uint8_t> encoded_pixels;
+struct ImageEncoder {
+  static bool Encode(Vector<unsigned char>*,const SkPixmap& p,ImageEncodingMimeType,double){
+    auto bytes=gfx::SkPixmapToSpan(p);encoded_pixels.assign(bytes.begin(),bytes.end());return true;
+  }
+};
+namespace ImageEncoderUtils {std::string_view MimeTypeName(ImageEncodingMimeType){return "image/png";}}
+String Base64Encode(const Vector<unsigned char>&){return "";}
+String StrCat(std::initializer_list<std::string_view> parts){String out;for(auto p:parts)out+=p;return out;}
+struct ImageDataBuffer {
+  bool is_valid_=true;
+  SkPixmap pixmap_;
+  explicit ImageDataBuffer(SkPixmap p):pixmap_(p){}
+  String ToDataURL(ImageEncodingMimeType,const double&)const;
+};
+PRODUCTION_CANVAS
+}
+
+int main(int argc,char** argv){
+  assert(argc==2);std::string test=argv[1];
+  Set("chromium.enable","1");
+  if(test=="ipv4-canonical"){
+    assert(!blink::webview::IsIPv4("0001.2.3.4"));
+    assert(!blink::webview::IsIPv4("01.2.3.4"));
+  } else if(test=="ice-whitespace"){
+    Set("chromium.webrtc.public_ip","203.0.113.1");
+    Set("chromium.webrtc.private_ip","192.168.1.1");
+    std::string input="candidate:1  1 udp 1 198.51.100.1 1234 typ srflx  raddr 10.0.0.1 rport 4567 ";
+    auto result=blink::WebViewPropertyOverrides().IceCandidate(input);
+    assert(result=="candidate:1  1 udp 1 203.0.113.1 1234 typ srflx  raddr 192.168.1.1 rport 4567 ");
+  } else if(test=="ice-invalid-prefix"){
+    Set("chromium.webrtc.private_ip","192.168.1.1");
+    std::string input="invalid 1 udp 1 10.0.0.1 1234 typ host";
+    assert(blink::WebViewPropertyOverrides().IceCandidate(input)==input);
+  } else if(test=="metadata-invalid-ascii"){
+    Set("chromium.navigator.userAgentMeta.model","bad\r\nvalue");
+    blink::UserAgentMetadata metadata;blink::ApplyUserAgentPropertyOverrides(metadata,false);
+    assert(metadata.model=="Pixel");
+  } else if(test=="metadata-one-enable-read"){
+    blink::UserAgentMetadata metadata;reads.clear();
+    blink::ApplyUserAgentPropertyOverrides(metadata,false);
+    assert(reads["chromium.enable"]==1);
+  } else if(test=="audio-native-read"){
+    Set("chromium.audio.randomDouble","1");
+    blink::AudioBuffer audio;auto original=audio.channels_[0].value.data;
+    audio.getChannelData(0);
+    assert(audio.channels_[0].value.data==original);
+    assert(audio.property_noise_applied_[0]==0);
+    audio.MaybeApplyPropertyNoise(0);
+    assert(audio.channels_[0].value.data!=original);
+    auto changed=audio.channels_[0].value.data;audio.MaybeApplyPropertyNoise(0);
+    assert(changed==audio.channels_[0].value.data);
+  } else if(test=="audio-zero-reuse"){
+    Set("chromium.audio.randomDouble","1");
+    blink::AudioBuffer audio;audio.MaybeApplyPropertyNoise(0);audio.Zero();
+    assert(audio.property_noise_applied_[0]==0);
+    for(float value:audio.channels_[0].value.data)assert(value==0);
+    audio.channels_[0].value.data.fill(0.25f);
+    auto original=audio.channels_[0].value.data;audio.MaybeApplyPropertyNoise(0);
+    assert(audio.channels_[0].value.data!=original);
+  } else if(test=="canvas-other-row"){
+    Set("chromium.canvas.toDataUrl.randomDouble","1");
+    std::array<uint8_t,8> pixels{0,0,0,0,20,20,20,255};auto original=pixels;
+    blink::ImageDataBuffer image(blink::SkPixmap({1,2},pixels.data(),4));
+    image.ToDataURL(blink::ImageEncodingMimeType::kPNG,1);
+    assert(blink::encoded_pixels!=std::vector<uint8_t>(original.begin(),original.end()));
+    assert(pixels==original);
+  } else if(test=="canvas-transparent-copy"){
+    Set("chromium.canvas.toDataUrl.randomDouble","1");
+    std::array<uint8_t,8> pixels{};
+    blink::ImageDataBuffer image(blink::SkPixmap({1,2},pixels.data(),4));
+    image.ToDataURL(blink::ImageEncodingMimeType::kPNG,1);
+    assert(blink::copies==0);
+  } else {return 2;}
+}

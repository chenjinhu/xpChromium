+// static
+void AwProxyingURLLoaderFactory::ApplyPropertyHeaderOverrides(
+    network::HttpRequestHeadersUpdateParams& updates) {
+  const blink::WebViewPropertyOverrides properties;
+  if (auto value = properties.RequestedWith()) {
+    const std::string key = content::GetCorsExemptRequestedWithHeaderName();
+    updates.RemoveHeader(key);
+    if (!value->empty()) {
+      updates.SetCorsExemptHeader(key, *value);
+    }
+  }
+  if (auto value = properties.UserAgent()) {
+    updates.RemoveHeader(net::HttpRequestHeaders::kUserAgent);
+    updates.SetHeader(net::HttpRequestHeaders::kUserAgent, *value);
+  }
+}

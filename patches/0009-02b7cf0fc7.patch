+namespace blink {
+
+// Capture the master switch once per operation. Do not keep instances across
+// navigations: individual properties are read when requested, not cached.
+class BLINK_COMMON_EXPORT WebViewPropertyOverrides {
+ public:
+  WebViewPropertyOverrides();
+  bool enabled() const { return enabled_; }
+  std::optional<std::string> GetString(const char* name) const;

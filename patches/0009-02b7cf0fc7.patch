+                                  double min,
+                                  double max) const;
+  std::optional<bool> GetBool(const char* name) const;
+  std::optional<std::string> UserAgent() const;
+  // nullopt: upstream policy; empty string: remove; otherwise replace.
+  std::optional<std::string> RequestedWith() const;
+  std::vector<std::pair<std::string, std::string>> Brands(
+      const char* name) const;
+  std::optional<std::string> IceAddress(std::string_view type,
+                                        bool related = false) const;
+  std::string IceCandidate(std::string_view input) const;
+  std::string RedactSdp(std::string_view input) const;
+
+ private:
+  const bool enabled_;
+};

+static void JNI_AwFingerprintConfig_InitializeFromFile(JNIEnv* env) {
+  static std::once_flag initialized;
+  std::call_once(initialized, [] {
+    std::string json;
+    std::string error;
+    const auto status = ReadFingerprintConfigFile(
+        base::FilePath(kFingerprintConfigPath), json, error);
+    if (status == FingerprintFileStatus::kLoaded) {
+      error = blink::ConfigureWebViewFingerprint(json);
+      if (error.empty()) {
+        LOG(INFO) << "Loaded fingerprint configuration from "
+                  << kFingerprintConfigPath;
+      }
+    } else if (status == FingerprintFileStatus::kMissing) {
+      LOG(INFO) << "No fingerprint configuration file; using native defaults";
+    }
+    if (!error.empty()) {
+      LOG(ERROR) << "Fingerprint file was not applied: " << error;
+    }
+    blink::FreezeWebViewFingerprint();
+  });
 }
 }  // namespace android_webview
 

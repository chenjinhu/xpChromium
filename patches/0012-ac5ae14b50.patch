+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <sys/system_properties.h>
+
+#include <cassert>
+#include <string>
+#include <vector>
+
+#include "third_party/blink/public/common/webview/property_overrides.h"
+
+#define CHECK assert
+namespace base {
+bool StringToInt(const std::string& text, int* value) {
+  *value = std::stoi(text);
+  return true;
+}
+}  // namespace base
+namespace blink {
+struct UserAgentBrandVersion {
+  std::string brand, version;
+  UserAgentBrandVersion(std::string a, std::string b) : brand(a), version(b) {}
+};
+using UserAgentBrandList = std::vector<UserAgentBrandVersion>;
+enum class UserAgentBrandVersionType { kMajorVersion, kFullVersion };
+struct UserAgentMetadata {
+  UserAgentBrandList brand_version_list, brand_full_version_list;
+  bool mobile = false, wow64 = false;
+  std::string platform = "Android", platform_version, architecture, model,
+              full_version, bitness;
+};
+PRODUCTION_METADATA
+}  // namespace blink
+namespace version_info {
+std::string GetVersionNumber() {
+  return "158.0.8109.0";
+}
+}  // namespace version_info
+namespace embedder_support {
+// Boundary adapter only: the production policy must use this upstream API.
+blink::UserAgentBrandList GenerateBrandVersionList(
+    int seed,
+    const char* product,
+    const std::string& version,
+    blink::UserAgentBrandVersionType type) {
+  assert(seed == std::stoi(version));
+  return {{"GREASE", "99"}, {"Chromium", version}, {product, version}};
+}
+}  // namespace embedder_support
+namespace android_webview {
+constexpr char kAndroidWebViewProductName[] = "Android WebView";
+struct AwClientHintsControllerDelegate {
+  static void ApplyFingerprintOverrides(blink::UserAgentMetadata&, bool);
+};
+PRODUCTION_AUTO_BRANDS
+}  // namespace android_webview
+
+void Set(const char* key, const char* value) {
+  props[key] = {key, value};
+}
+int main() {
+  using android_webview::AwClientHintsControllerDelegate;
+  blink::UserAgentMetadata metadata;
+  metadata.full_version = "native";
+  AwClientHintsControllerDelegate::ApplyFingerprintOverrides(metadata, false);
+  assert(metadata.full_version == "native");
+  Set("chromium.enable", "1");
+  AwClientHintsControllerDelegate::ApplyFingerprintOverrides(metadata, false);
+  assert(metadata.brand_version_list[1].version == "158");
+  assert(metadata.brand_full_version_list[1].version == "158.0.8109.0");
+  assert(metadata.brand_version_list[0].brand == "GREASE");
+  Set("chromium.navigator.useragent",
+      "Mozilla/5.0 Chrome/157.0.8000.2 Mobile Safari/537.36");
+  AwClientHintsControllerDelegate::ApplyFingerprintOverrides(metadata, false);
+  assert(metadata.brand_version_list[1].version == "157");
+  assert(metadata.full_version == "157.0.8000.2");
+  blink::UserAgentMetadata low;
+  AwClientHintsControllerDelegate::ApplyFingerprintOverrides(low, true);
+  assert(low.brand_version_list[1].version == "157");
+  assert(low.brand_full_version_list.empty() && low.full_version.empty());
+  for (const char* ua : {"Chrome/157", "Chrome/1.2.3", "NotChrome/157.0.1.2",
+                         "Chrome/0157.0.1.2", "Chrome/999999999999.0.1.2",
+                         "Chrome/157.0.1.2.3", "Chrome/157.0.1.2evil"}) {
+    Set("chromium.navigator.useragent", ua);
+    assert(!blink::WebViewPropertyOverrides().UserAgentVersion());
+    AwClientHintsControllerDelegate::ApplyFingerprintOverrides(metadata, false);
+    assert(metadata.full_version == "158.0.8109.0");
+  }
+  Set("chromium.navigator.userAgentMeta.brands", "Custom,42");
+  Set("chromium.navigator.userAgentMeta.fullVersionList", "Custom,42.1.2.3");
+  Set("chromium.navigator.userAgentMeta.fullVersion", "42.1.2.3");
+  AwClientHintsControllerDelegate::ApplyFingerprintOverrides(metadata, false);
+  assert(metadata.brand_version_list.size() == 1);
+  assert(metadata.brand_version_list[0].brand == "Custom");
+  assert(metadata.brand_full_version_list[0].version == "42.1.2.3");
+  assert(metadata.full_version == "42.1.2.3");
+}

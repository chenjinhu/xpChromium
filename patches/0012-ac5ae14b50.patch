+void AwClientHintsControllerDelegate::ApplyFingerprintOverrides(
+    blink::UserAgentMetadata& metadata,
+    bool only_low_entropy_ch) {
+  const blink::WebViewPropertyOverrides config;
+  if (!config.enabled()) {
+    return;
+  }
+  // Omitted brands use Chromium's native GREASE and ordering implementation.
+  // A full Chrome/ version in the configured UA supplies the version; otherwise
+  // use this build's actual version, rather than guessing from arbitrary text.
+  const std::string version = config.UserAgentVersion().value_or(
+      std::string(version_info::GetVersionNumber()));
+  const auto separator = version.find('.');
+  const std::string major = version.substr(0, separator);
+  int seed;
+  CHECK(base::StringToInt(major, &seed));
+  metadata.brand_version_list = embedder_support::GenerateBrandVersionList(
+      seed, kAndroidWebViewProductName, major,
+      blink::UserAgentBrandVersionType::kMajorVersion);
+  if (!only_low_entropy_ch) {
+    metadata.full_version = version;
+    metadata.brand_full_version_list =
+        embedder_support::GenerateBrandVersionList(
+            seed, kAndroidWebViewProductName, version,
+            blink::UserAgentBrandVersionType::kFullVersion);
+  }
+  blink::ApplyUserAgentPropertyOverrides(metadata, only_low_entropy_ch);
+}
+
 network::NetworkQualityTracker*

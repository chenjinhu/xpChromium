+std::optional<std::string> WebViewPropertyOverrides::UserAgentVersion() const {
+  auto ua = UserAgent();
+  if (!ua) {
+    return std::nullopt;
+  }
+  std::string_view remaining(*ua);
+  const size_t token = remaining.find("Chrome/");
+  if (token == std::string_view::npos ||
+      (token != 0 && remaining[token - 1] != ' ')) {
+    return std::nullopt;
+  }
+  remaining.remove_prefix(token + 7);
+  const auto version = remaining.substr(0, remaining.find(' '));
+  std::string_view components = version;
+  for (int i = 0; i < 4; ++i) {
+    const auto dot = components.find('.');
+    const auto part = components.substr(0, dot);
+    unsigned number;
+    auto result = std::from_chars(std::to_address(part.begin()),
+                                  std::to_address(part.end()), number);
+    if (part.empty() || (part.size() > 1 && part.front() == '0') ||
+        result.ec != std::errc() || result.ptr != std::to_address(part.end()) ||
+        (i == 0 && (number == 0 || number > 2147483647u))) {
+      return std::nullopt;
+    }
+    if (i == 3) {
+      return dot == std::string_view::npos
+                 ? std::make_optional(std::string(version))
+                 : std::nullopt;
+    }
+    if (dot == std::string_view::npos) {
+      return std::nullopt;
+    }
+    components.remove_prefix(dot + 1);
+  }
+  return std::nullopt;
+}

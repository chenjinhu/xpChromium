index 0000000000000000000000000000000000000000..d284fa2f87f184b8531a91c6f242ac8d8ffe8cc8
--- /dev/null
+++ b/android_webview/browser/aw_fingerprint_config_file.cc
@@ -0,0 +1,58 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "android_webview/browser/aw_fingerprint_config_file.h"
+
+#include <fcntl.h>
+#include <sys/stat.h>
+
+#include <cerrno>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/posix/eintr_wrapper.h"
+
+namespace android_webview {
+
+FingerprintFileStatus ReadFingerprintConfigFile(const base::FilePath& path,
+                                                std::string& json,
+                                                std::string& error) {
+  json.clear();
+  error.clear();
+  // Nonblocking open also prevents a FIFO at this shared path from hanging
+  // WebView startup. Only regular files are accepted after opening.
+  const int descriptor = HANDLE_EINTR(
+      open(path.value().c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK));
+  if (descriptor < 0) {
+    if (errno == ENOENT) {
+      return FingerprintFileStatus::kMissing;
+    }
+    error = "Cannot open fingerprint file; check host app storage permissions";
+    return FingerprintFileStatus::kError;
+  }
+  base::File file(descriptor);
+  struct stat info;
+  if (fstat(file.GetPlatformFile(), &info) != 0 || !S_ISREG(info.st_mode)) {
+    error = "Fingerprint path must refer to a regular file";
+    return FingerprintFileStatus::kError;
+  }
+  constexpr size_t kMaxBytes = 32768;
+  if (info.st_size <= 0 || info.st_size > static_cast<int64_t>(kMaxBytes)) {
+    error = "Fingerprint file must contain 1..32768 bytes";
+    return FingerprintFileStatus::kError;
+  }
+  // Read one extra byte to detect growth beyond the maximum after fstat.
+  std::vector<uint8_t> bytes(kMaxBytes + 1);
+  auto count = file.Read(0, bytes);
+  if (!count || *count == 0 || *count > kMaxBytes) {
+    error = "Fingerprint file read failed or exceeded 32768 bytes";
+    return FingerprintFileStatus::kError;
+  }
+  const auto contents = base::span(bytes).first(*count);
+  json.assign(contents.begin(), contents.end());
+  return FingerprintFileStatus::kLoaded;
+}
+
+}  // namespace android_webview

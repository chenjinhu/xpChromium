+      std::unique_ptr<TimeZoneController::TimeZoneOverride>>
+      handle;
+  static bool locale_claimed = false;
+  if (!zone.empty()) {
+    if (*handle) {
+      (*handle)->change(zone);
+    } else {
+      auto result = TimeZoneController::SetTimeZoneOverride(zone);
+      if (!result.handle) {
+        return false;
+      }
+      *handle = std::move(result.handle);
+    }
+  }
+  if (!language.empty()) {
+    if (!LocaleController::instance()
+             .SetLocaleOverride(language, !locale_claimed)
+             .empty()) {
+      return false;
+    }
+    locale_claimed = true;
+  }
+  return true;

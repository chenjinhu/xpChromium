+namespace net {
+namespace {
+class NetworkSessionIdentityTest : public testing::Test,
+                                   public WithTaskEnvironment {};
+TEST_F(NetworkSessionIdentityTest,
+       EndpointScopedProxyAuthenticationAndRotation) {
+  auto context = CreateTestURLRequestContextBuilder()->Build();
+  auto* session = context->http_transaction_factory()->GetSession();
+  const auto proxy =
+      ProxyUriToProxyChain("https://proxy.test:8443", ProxyServer::SCHEME_HTTP)
+          .First();
+  const AuthCredentials credentials(u"user", u"pass");
+  session->SetProxyAuthentication(proxy, credentials);
+  auto* cache = session->http_auth_cache();
+  auto* entry =
+      cache->LookupByPath(url::SchemeHostPort("https", "proxy.test", 8443),
+                          HttpAuth::AUTH_PROXY, NetworkAnonymizationKey(), "/");
+  ASSERT_TRUE(entry);
+  EXPECT_TRUE(entry->credentials().Equals(credentials));
+  EXPECT_FALSE(cache->LookupByPath(
+      url::SchemeHostPort("https", "proxy.test", 8443), HttpAuth::AUTH_SERVER,
+      NetworkAnonymizationKey(), "/"));
+  EXPECT_FALSE(cache->LookupByPath(
+      url::SchemeHostPort("https", "other.test", 8443), HttpAuth::AUTH_PROXY,
+      NetworkAnonymizationKey(), "/"));
+  EXPECT_FALSE(cache->LookupByPath(
+      url::SchemeHostPort("https", "proxy.test", 443), HttpAuth::AUTH_PROXY,
+      NetworkAnonymizationKey(), "/"));
+  auto controller = base::MakeRefCounted<HttpAuthController>(
+      HttpAuth::AUTH_PROXY, GURL("https://proxy.test:8443"),
+      NetworkAnonymizationKey(), cache, context->http_auth_handler_factory(),
+      context->host_resolver());
+  HttpRequestInfo request;
+  TestCompletionCallback callback;
+  EXPECT_EQ(callback.GetResult(controller->MaybeGenerateAuthToken(
+                &request, SSLInfo(), callback.callback(), NetLogWithSource())),
+            OK);
+  ASSERT_TRUE(controller->HaveAuth());
+  HttpRequestHeaders auth_headers;
+  controller->AddAuthorizationHeader(&auth_headers);
+  EXPECT_EQ(auth_headers.GetHeader("Proxy-Authorization"),
+            "Basic dXNlcjpwYXNz");
+  EXPECT_FALSE(auth_headers.HasHeader("Authorization"));
+  const auto socks =
+      ProxyUriToProxyChain("socks5://socks.test:1080", ProxyServer::SCHEME_HTTP)
+          .First();
+  session->SetProxyAuthentication(socks, credentials);
+  EXPECT_FALSE(cache->LookupByPath(
+      url::SchemeHostPort("https", "proxy.test", 8443), HttpAuth::AUTH_PROXY,
+      NetworkAnonymizationKey(), "/"));
+  ASSERT_EQ(session->socks5_auth().size(), 1u);
+  EXPECT_TRUE(session->socks5_auth()
+                  .at(HostPortPair("socks.test", 1080))
+                  .Equals(credentials));
+  session->SetProxyAuthentication(ProxyServer(), std::nullopt);
+  EXPECT_TRUE(session->socks5_auth().empty());
+}
+TEST_F(NetworkSessionIdentityTest, ChallengeCredentialsAreProxyOnlyAndBounded) {
+  auto context = CreateTestURLRequestContextBuilder()->Build();
+  auto* session = context->http_transaction_factory()->GetSession();
+  const auto proxy =
+      ProxyUriToProxyChain("http://proxy.test:8080", ProxyServer::SCHEME_HTTP)
+          .First();
+  session->SetProxyAuthentication(proxy, AuthCredentials(u"user", u"pass"));
+  auto* cache = session->http_auth_cache();
+  // A real Digest challenge with no matching realm cache entry must select
+  // configured credentials. A wrong-password repeat must request intervention.
+  auto headers = base::MakeRefCounted<
+      HttpResponseHeaders>(HttpUtil::AssembleRawHeaders(
+      "HTTP/1.1 407 Proxy Authentication Required\nProxy-Authenticate: Digest "
+      "realm=\"r\", nonce=\"n\", qop=\"auth\"\n\n"));
+  auto controller = base::MakeRefCounted<HttpAuthController>(
+      HttpAuth::AUTH_PROXY, GURL("http://proxy.test:8080"),
+      NetworkAnonymizationKey(), cache, context->http_auth_handler_factory(),
+      context->host_resolver());
+  EXPECT_EQ(controller->HandleAuthChallenge(headers, SSLInfo(), false, true,
+                                            NetLogWithSource()),
+            OK);
+  EXPECT_TRUE(controller->HaveAuth());
+  EXPECT_EQ(controller->HandleAuthChallenge(headers, SSLInfo(), false, true,
+                                            NetLogWithSource()),
+            OK);
+  EXPECT_FALSE(controller->HaveAuth());
+  auto origin = base::MakeRefCounted<HttpAuthController>(
+      HttpAuth::AUTH_SERVER, GURL("http://proxy.test:8080"),
+      NetworkAnonymizationKey(), cache, context->http_auth_handler_factory(),
+      context->host_resolver());
+  auto unauthorized =
+      base::MakeRefCounted<HttpResponseHeaders>(HttpUtil::AssembleRawHeaders(
+          "HTTP/1.1 401 Unauthorized\nWWW-Authenticate: Basic "
+          "realm=\"origin\"\n\n"));
+  EXPECT_EQ(origin->HandleAuthChallenge(unauthorized, SSLInfo(), false, false,
+                                        NetLogWithSource()),
+            OK);
+  EXPECT_FALSE(origin->HaveAuth());
+}
+TEST_F(NetworkSessionIdentityTest, NativeAndRestrictedUrls) {
+  const uint16_t ports[] = {22, 3389};
+  for (const char* url :
+       {"http://localhost", "http://127.1", "http://2130706433",
+        "http://192.168.1.2", "http://[::1]", "http://[::ffff:127.0.0.1]",
+        "http://router.local"}) {
+    EXPECT_TRUE(IdentityAllowsUrl(GURL(url), false, {}));
+    EXPECT_FALSE(IdentityAllowsUrl(GURL(url), true, {})) << url;
+  }
+  EXPECT_TRUE(IdentityAllowsUrl(GURL("https://example.com/"), true, ports));
+  EXPECT_FALSE(
+      IdentityAllowsUrl(GURL("https://example.com:3389/"), false, ports));
+  EXPECT_FALSE(IdentityAllowsUrl(GURL("wss://example.com:22/"), false, ports));
+  EXPECT_TRUE(IdentityAllowsUrl(GURL("https://8.8.8.8/"), true, ports));
+}

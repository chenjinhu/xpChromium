diff --git a/webview_custom/tests/identity_utils_test.cc b/webview_custom/tests/identity_utils_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1bbd90b42e98f1a6988285ea71628e99853b34a4
--- /dev/null
+++ b/webview_custom/tests/identity_utils_test.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/webview/identity_utils.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <vector>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/containers/span.h"
+
+int main() {
+  using blink::webview::IdentityHash;
+  using blink::webview::ProjectIdentityPixels;
+  constexpr size_t width = 96;
+  constexpr size_t height = 48;
+  constexpr size_t stride = width * 4 + 12;
+  std::vector<uint8_t> original(stride * height, 0xa5);
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      auto pixel = base::span(original).subspan(y * stride + x * 4, size_t{4});
+      pixel[0] = x * 2;
+      pixel[1] = y * 4;
+      pixel[2] = (x + y) % 256;
+      pixel[3] = x % 7 ? 255 : 0;
+    }
+  }
+  const uint64_t seed = IdentityHash("stable-profile");
+  auto full = original;
+  ProjectIdentityPixels(full, width, height, stride, 0, 0, false, false, seed);
+  CHECK(full != original);
+  auto repeated = full;
+  ProjectIdentityPixels(repeated, width, height, stride, 0, 0, false, false,
+                        seed);
+  CHECK(full == repeated);  // Export -> decode -> read does not accumulate.
+  auto other = original;
+  ProjectIdentityPixels(other, width, height, stride, 0, 0, false, false,
+                        IdentityHash("different-profile"));
+  CHECK(other != full);
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      const size_t i = y * stride + x * 4;
+      CHECK_EQ(full[i + 3], original[i + 3]);
+      for (size_t c = 0; c < 3; ++c) {
+        CHECK_LE(std::abs(int(full[i + c]) - int(original[i + c])), 1);
+        if (!original[i + 3]) {
+          CHECK_EQ(full[i + c], original[i + c]);
+        }
+      }
+    }
+    CHECK(std::equal(original.begin() + y * stride + width * 4,
+                     original.begin() + (y + 1) * stride,
+                     full.begin() + y * stride + width * 4));
+  }
+  // A cropped getImageData request must agree with a full PNG readback.
+  constexpr size_t left = 11, top = 9, crop_width = 63, crop_height = 31;
+  std::vector<uint8_t> crop(crop_width * crop_height * 4);
+  for (size_t y = 0; y < crop_height; ++y) {
+    std::copy_n(original.begin() + (top + y) * stride + left * 4,
+                crop_width * 4, crop.begin() + y * crop_width * 4);
+  }
+  ProjectIdentityPixels(crop, crop_width, crop_height, crop_width * 4, left,
+                        top, false, false, seed);
+  for (size_t y = 0; y < crop_height; ++y) {
+    CHECK(std::equal(crop.begin() + y * crop_width * 4,
+                     crop.begin() + (y + 1) * crop_width * 4,
+                     full.begin() + (top + y) * stride + left * 4));
+  }
+  // WebGL bottom-up RGBA and encoder BGRA must map to the same logical pixels.
+  auto bgra = original;
+  auto bottom = original;
+  for (size_t y = 0; y < height; ++y) {
+    std::copy_n(original.begin() + y * stride, stride,
+                bottom.begin() + (height - y - 1) * stride);
+    for (size_t x = 0; x < width; ++x) {
+      std::swap(bgra[y * stride + x * 4], bgra[y * stride + x * 4 + 2]);
+    }
+  }
+  ProjectIdentityPixels(bgra, width, height, stride, 0, 0, true, false, seed);
+  ProjectIdentityPixels(bottom, width, height, stride, 0, 0, false, true, seed);
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      const size_t i = y * stride + x * 4;
+      CHECK_EQ(bgra[i], full[i + 2]);
+      CHECK_EQ(bgra[i + 2], full[i]);
+    }
+    CHECK(std::equal(full.begin() + y * stride,
+                     full.begin() + y * stride + width * 4,
+                     bottom.begin() + (height - y - 1) * stride));
+  }
+  // Last-row padding need not be addressable, as in WebGL packed readbacks.
+  auto tight_tail = original;
+  tight_tail.resize(stride * (height - 1) + width * 4);
+  ProjectIdentityPixels(tight_tail, width, height, stride, 0, 0, false, false,
+                        seed);
+  CHECK(std::equal(tight_tail.begin(), tight_tail.end(), full.begin()));
+  auto invalid = original;
+  ProjectIdentityPixels(invalid, width, height, width * 4 - 1, 0, 0, false,
+                        false, seed);
+  CHECK(invalid == original);
+  CHECK_EQ(blink::webview::IdentitySample(0, seed, 0), 0);
+  CHECK_EQ(
+      blink::webview::IdentitySample(2, seed, 0),
+      static_cast<float>(2 + blink::webview::IdentityNoise(seed, 0) * 1e-7));
+  CHECK(std::isinf(blink::webview::IdentityFrequency(
+      -std::numeric_limits<double>::infinity(), seed, 1)));
+  CHECK(std::isnan(blink::webview::IdentitySample(
+      std::numeric_limits<float>::quiet_NaN(), seed, 1)));
+  std::cout << "PASS deterministic/idempotent pixels, subrect/stride/alpha, "
+               "RGBA/BGRA/WebGL orientation and audio boundaries\n";
+}

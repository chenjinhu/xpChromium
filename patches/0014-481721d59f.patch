+  CHECK(proxy);
+  CHECK_EQ(proxy->uri, "socks5://[::1]:1080");
+  CHECK_EQ(*proxy->username, "u");
+  CHECK(!ParseAwProxyResponse("DIRECT"));
+  CHECK(!ParseAwProxyResponse("http://u:p@example.com:80"));
+  CHECK(!ParseAwProxyResponse("http://host:80; DIRECT"));
+  CHECK(!ParseAwProxyResponse(R"({"host":"a","port":65536})"));
+  auto ip = ParseAwIpIdentity(
+      R"({"success":true,"latitude":"22.5","longitude":114,"country_code":"CN","timezone":{"id":"Asia/Shanghai"}})");
+  CHECK(ip);
+  CHECK_EQ(ip->regional.timezone, "Asia/Shanghai");
+  CHECK_EQ(ip->regional.languages.front(), "zh-CN");
+  CHECK_EQ(*ip->latitude, 22.5);
+  CHECK(!ParseAwIpIdentity(R"({"success":false})"));
+  CHECK(!ParseAwIpIdentity(R"({"languages":["en-US\r\nX:bad"]})"));

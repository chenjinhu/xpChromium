+  DCHECK(IsMainThread());
+  const String zone = timezone;
+  const String language = locale;
+  if ((!zone.empty() && !IsWebViewTimeZone(zone.Utf8())) ||
+      (!language.empty() && !IsWebViewLanguage(language.Utf8()))) {
+    return false;

new file mode 100644
index 0000000000000000000000000000000000000000..65de57bdf9830cfc2fd38d56dabdd50e9526443e
--- /dev/null
+++ b/third_party/blink/common/webview/regional_settings.cc
@@ -0,0 +1,86 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "third_party/blink/public/common/webview/regional_settings.h"
+
+#include <unicode/timezone.h>
+#include <unicode/uloc.h>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/synchronization/lock.h"
+namespace blink {
+namespace {
+struct RegionalStore {
+  base::Lock lock;
+  std::shared_ptr<const WebViewRegionalSettings> value =
+      std::make_shared<WebViewRegionalSettings>();
+};
+RegionalStore& Store() {
+  static base::NoDestructor<RegionalStore> store;
+  return *store;
+}
+}  // namespace
+bool IsWebViewLanguage(std::string_view language) {
+  if (language.empty() || language.size() > 128 ||
+      !base::IsStringASCII(language)) {
+    return false;
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  char locale[ULOC_FULLNAME_CAPACITY];
+  int32_t parsed = 0;
+  uloc_forLanguageTag(std::string(language).c_str(), locale, sizeof(locale),
+                      &parsed, &error);
+  return U_SUCCESS(error) && parsed == static_cast<int32_t>(language.size());
+}
+bool IsWebViewTimeZone(std::string_view timezone) {
+  if (timezone.empty() || timezone.size() > 128 ||
+      !base::IsStringASCII(timezone)) {
+    return false;
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  icu::UnicodeString canonical;
+  UBool system = false;
+  icu::TimeZone::getCanonicalID(icu::UnicodeString::fromUTF8(timezone),
+                                canonical, system, error);
+  return U_SUCCESS(error) && system &&
+         canonical != icu::UnicodeString("Etc/Unknown");
+}
+std::vector<std::string> WebViewCountryLanguages(std::string_view country) {
+  if (country.size() != 2 || !base::IsAsciiAlpha(country[0]) ||
+      !base::IsAsciiAlpha(country[1])) {
+    return {};
+  }
+  const std::string region = base::ToUpperASCII(country);
+  UErrorCode error = U_ZERO_ERROR;
+  char locale[ULOC_FULLNAME_CAPACITY];
+  uloc_addLikelySubtags(("und_" + region).c_str(), locale, sizeof(locale),
+                        &error);
+  char language[ULOC_LANG_CAPACITY];
+  uloc_getLanguage(locale, language, sizeof(language), &error);
+  if (U_FAILURE(error) || !*language || std::string_view(language) == "und") {
+    return {};
+  }
+  return {std::string(language) + "-" + region, language};
+}
+bool SetWebViewRegionalSettings(WebViewRegionalSettings settings) {
+  if ((!settings.timezone.empty() && !IsWebViewTimeZone(settings.timezone)) ||
+      settings.languages.size() > 32) {
+    return false;
+  }
+  for (const auto& language : settings.languages) {
+    if (!IsWebViewLanguage(language)) {
+      return false;
+    }
+  }
+  auto& store = Store();
+  base::AutoLock lock(store.lock);
+  store.value = std::make_shared<WebViewRegionalSettings>(std::move(settings));
+  return true;
+}
+std::shared_ptr<const WebViewRegionalSettings> GetWebViewRegionalSettings() {
+  auto& store = Store();
+  base::AutoLock lock(store.lock);
+  return store.value;
+}
+}  // namespace blink

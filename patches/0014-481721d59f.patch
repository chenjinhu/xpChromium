index 0000000000000000000000000000000000000000..d81e559ff886e1c67330caafb796bdcd7caa5539
--- /dev/null
+++ b/third_party/blink/common/webview/identity_utils.cc
@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/webview/identity_utils.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace blink::webview {
+namespace {
+uint64_t Mix(uint64_t value) {
+  value ^= value >> 30;
+  value *= 0xbf58476d1ce4e5b9ull;
+  value ^= value >> 27;
+  value *= 0x94d049bb133111ebull;
+  return value ^ (value >> 31);
+}
+}  // namespace
+
+uint64_t IdentityHash(std::string_view text, uint64_t seed) {
+  for (unsigned char byte : text) {
+    seed ^= byte;
+    seed *= 1099511628211ull;
+  }
+  return seed;
+}
+
+double IdentityNoise(uint64_t seed, uint64_t index) {
+  return static_cast<double>(Mix(seed ^ Mix(index)) >> 11) /
+             4503599627370496.0 -
+         1.0;
+}
+
+void ProjectIdentityPixels(base::span<uint8_t> bytes,
+                           size_t width,
+                           size_t height,
+                           size_t row_bytes,
+                           int64_t origin_x,
+                           int64_t origin_y,
+                           bool bgra,
+                           bool bottom_up,
+                           uint64_t seed) {
+  if (!width || !height || width > std::numeric_limits<size_t>::max() / 4 ||
+      row_bytes < width * 4 || width * 4 > bytes.size() ||
+      height - 1 > (bytes.size() - width * 4) / row_bytes) {
+    return;
+  }
+  for (size_t row = 0; row < height; ++row) {
+    const uint64_t y =
+        static_cast<uint64_t>(origin_y) + (bottom_up ? height - row - 1 : row);
+    auto data = bytes.subspan(row * row_bytes, width * 4);
+    for (size_t column = 0; column < width; ++column) {
+      const uint64_t x = static_cast<uint64_t>(origin_x) + column;
+      const uint64_t hash = Mix(seed ^ Mix(x) ^ Mix(y + 0x9e3779b97f4a7c15ull));
+      if ((hash & 63) || data[column * 4 + 3] != 255) {
+        continue;
+      }
+      size_t channel = (hash >> 8) % 3;
+      if (bgra && channel != 1) {
+        channel = 2 - channel;
+      }
+      auto& sample = data[column * 4 + channel];
+      sample = (sample & 0xfe) | ((hash >> 16) & 1);
+    }
+  }
+}
+
+double IdentityFrequency(double decibels, uint64_t seed, size_t index) {
+  return std::isfinite(decibels) ? decibels + IdentityNoise(seed, index) * 0.05
+                                 : decibels;
+}
+
+float IdentitySample(float sample, uint64_t seed, size_t index) {
+  if (!std::isfinite(sample) || sample == 0) {
+    return sample;
+  }
+  return static_cast<float>(sample + IdentityNoise(seed, index) * 1e-7);
+}
+
+}  // namespace blink::webview

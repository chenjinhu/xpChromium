 namespace android_webview {
 
@@ -55,4 +57,21 @@ FingerprintFileStatus ReadFingerprintConfigFile(const base::FilePath& path,
   return FingerprintFileStatus::kLoaded;
 }
 
+FingerprintFileStatus ApplyFingerprintConfigFile(const base::FilePath& path,
+                                                 std::string& error) {
+  std::string json;
+  const auto status = ReadFingerprintConfigFile(path, json, error);
+  if (status == FingerprintFileStatus::kLoaded) {
+    error = blink::ConfigureWebViewFingerprint(json);
+  }
+  if (!error.empty()) {
+    const auto blocked = blink::ConfigureWebViewFingerprint(
+        R"({"version":1,"enabled":true,"settings":{"network.proxy_required":true}})");
+    CHECK(blocked.empty())
+        << "Cannot safely initialize WebView fingerprint policy";
+    return FingerprintFileStatus::kError;
+  }
+  return status;
+}
+
 }  // namespace android_webview

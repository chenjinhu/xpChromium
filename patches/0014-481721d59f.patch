+namespace blink::webview {
+
+// Stable non-cryptographic identity derivation. Never use this for secrets.
+BLINK_COMMON_EXPORT uint64_t
+IdentityHash(std::string_view text, uint64_t seed = 14695981039346656037ull);
+BLINK_COMMON_EXPORT double IdentityNoise(uint64_t seed, uint64_t index);

+namespace content {
+class WebContents;
+}
+namespace network {
+class SimpleURLLoader;
+class SharedURLLoaderFactory;
+}  // namespace network
+namespace android_webview {
+// Process-wide startup identity; not a profile or environment manager.
+class AwIdentityCoordinator {
+ public:
+  static AwIdentityCoordinator& Get();
+  bool active() const;
+  void Prepare(content::WebContents* contents,
+               base::OnceCallback<void(bool)> callback);
+  void Geolocation(
+      content::WebContents* contents,
+      base::OnceCallback<void(device::mojom::GeopositionResultPtr)> callback);
+
+ private:
+  friend class base::NoDestructor<AwIdentityCoordinator>;
+  AwIdentityCoordinator();
+  ~AwIdentityCoordinator();
+  struct Pending {
+    base::WeakPtr<content::WebContents> contents;
+    base::OnceCallback<void(bool)> callback;
+  };
+  enum class State { kIdle, kLoading, kReady, kFailed };
+  void InitializeManual();
+  void FetchProxy();
+  void OnProxy(std::optional<std::string> body);
+  void BeginNetworkChecks();
+  void CheckHealth();
+  void OnHealth(std::optional<std::string> body);
+  void FetchIp();
+  void OnIp(std::optional<std::string> body);
+  void Finish(bool success);
+  void ApplyNetwork(content::WebContents* contents,
+                    base::OnceCallback<void(bool)> callback);
+  void Fetch(const GURL& url,
+             scoped_refptr<network::SharedURLLoaderFactory> factory,
+             base::OnceCallback<void(std::optional<std::string>)> callback);
+  base::OneShotTimer watchdog_;
+  State state_ = State::kIdle;
+  base::TimeTicks last_attempt_;
+  base::WeakPtr<content::WebContents> active_contents_;
+  std::vector<Pending> pending_;
+  std::optional<AwIpIdentity> ip_;
+  bool proxy_resolved_ = false;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  mojo::Remote<network::mojom::NetworkContext> bootstrap_context_;
+  mojo::Remote<network::mojom::URLLoaderFactory> bootstrap_factory_;
+  base::WeakPtrFactory<AwIdentityCoordinator> weak_factory_{this};
+};
+}  // namespace android_webview
+#endif
diff --git a/android_webview/browser/aw_identity_data.cc b/android_webview/browser/aw_identity_data.cc
new file mode 100644
index 0000000000000000000000000000000000000000..63f2cddabc5af33513a6a60bbdee2f909d875cff
--- /dev/null
+++ b/android_webview/browser/aw_identity_data.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "android_webview/browser/aw_identity_data.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/proxy_string_util.h"
+namespace android_webview {
+namespace {
+bool Credential(const std::optional<std::string>& value) {
+  return !value || (value->size() <= 255 &&
+                    std::ranges::none_of(*value, [](unsigned char c) {
+                      return c < 32 || c == 127;
+                    }));
+}
+std::optional<std::string> Text(const base::DictValue& dict,
+                                const char* key,
+                                const char* alias) {
+  const auto* value = dict.FindString(key);
+  if (!value) {
+    value = dict.FindString(alias);
+  }
+  return value ? std::optional<std::string>(*value) : std::nullopt;
+}
+std::optional<double> Coordinate(const base::DictValue& dict,
+                                 const char* key,
+                                 double limit) {
+  const auto* value = dict.Find(key);
+  if (!value) {
+    return std::nullopt;
+  }
+  double number;
+  if (value->is_int() || value->is_double()) {
+    number = value->GetDouble();
+  } else if (!value->is_string() ||
+             !base::StringToDouble(value->GetString(), &number)) {
+    return std::nullopt;
+  }
+  return std::isfinite(number) && std::abs(number) <= limit
+             ? std::optional<double>(number)
+             : std::nullopt;
+}
+}  // namespace
+std::optional<AwResolvedProxy> ParseAwProxyResponse(std::string_view body) {
+  if (body.empty() || body.size() > 65536) {
+    return std::nullopt;
+  }
+  AwResolvedProxy result;
+  const auto root = base::JSONReader::Read(body, base::JSON_PARSE_RFC);
+  const base::Value* value = root ? &*root : nullptr;
+  if (value && value->is_dict()) {
+    if (const auto* data = value->GetDict().Find("data")) {
+      value = data;
+    }
+  }
+  if (value && value->is_dict()) {
+    const auto& dict = value->GetDict();
+    result.username = Text(dict, "username", "user");
+    result.password = Text(dict, "password", "pass");
+    if (const auto* proxy = dict.FindString("proxy")) {
+      result.uri = *proxy;
+    } else {
+      auto host = Text(dict, "host", "ip");
+      auto protocol = Text(dict, "protocol", "type");
+      int port = dict.FindInt("port").value_or(0);
+      if (const auto* text = dict.FindString("port")) {
+        base::StringToInt(*text, &port);
+      }
+      if (!host || host->empty() || port < 1 || port > 65535) {
+        return std::nullopt;
+      }
+      result.uri = base::ToLowerASCII(protocol.value_or("http")) + "://" +
+                   net::HostPortPair(*host, port).ToString();
+    }
+  } else if (value && value->is_string()) {
+    result.uri = value->GetString();
+  } else if (!root) {
+    result.uri = base::TrimWhitespaceASCII(body, base::TRIM_ALL);
+  } else {
+    return std::nullopt;
+  }
+  const std::string_view uri = result.uri;
+  if ((!uri.starts_with("http://") && !uri.starts_with("https://") &&
+       !uri.starts_with("socks5://")) ||
+      !Credential(result.username) || !Credential(result.password)) {
+    return std::nullopt;
+  }
+  const auto authority = uri.substr(uri.find("://") + 3);
+  if (authority.empty() ||
+      authority.find_first_of("/@?#\\,;=") != std::string_view::npos ||
+      !std::ranges::all_of(authority,
+                           [](unsigned char c) { return c > 32 && c < 127; })) {
+    return std::nullopt;
+  }
+  const auto chain =
+      net::ProxyUriToProxyChain(uri, net::ProxyServer::SCHEME_HTTP);
+  if (!chain.is_single_proxy() || !chain.First().host_port_pair().port()) {
+    return std::nullopt;
+  }
+  return result;
+}
+std::optional<AwIpIdentity> ParseAwIpIdentity(std::string_view body) {
+  if (body.size() > 65536) {
+    return std::nullopt;
+  }
+  const auto dict = base::JSONReader::ReadDict(body, base::JSON_PARSE_RFC);
+  if (!dict || (dict->Find("success") && dict->FindBool("success") != true)) {
+    return std::nullopt;
+  }
+  AwIpIdentity result;
+  result.latitude = Coordinate(*dict, "latitude", 90);
+  result.longitude = Coordinate(*dict, "longitude", 180);
+  const auto* timezone = dict->FindStringByDottedPath("timezone.id");
+  if (!timezone) {
+    timezone = dict->FindStringByDottedPath("time_zone.name");
+  }
+  if (!timezone) {
+    timezone = dict->FindString("timezone");
+  }
+  if (timezone && blink::IsWebViewTimeZone(*timezone)) {
+    result.regional.timezone = *timezone;
+  }
+  if (const auto* list = dict->FindList("languages")) {
+    for (const auto& language : *list) {
+      if (!language.is_string() ||
+          !blink::IsWebViewLanguage(language.GetString())) {
+        return std::nullopt;
+      }
+      result.regional.languages.push_back(language.GetString());
+    }
+  } else if (const auto* languages = dict->FindString("languages")) {
+    for (auto& language :
+         base::SplitString(*languages, ",", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY)) {
+      if (!blink::IsWebViewLanguage(language)) {
+        return std::nullopt;
+      }
+      result.regional.languages.push_back(std::move(language));
+    }
+  }
+  if (result.regional.languages.empty()) {
+    auto country = Text(*dict, "country_code", "countryCode");
+    if (country) {
+      result.regional.languages = blink::WebViewCountryLanguages(*country);
+    }
+  }
+  if (result.regional.languages.size() > 32) {
+    return std::nullopt;
+  }
+  return result;
+}
+}  // namespace android_webview

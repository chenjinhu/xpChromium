+void HttpNetworkSession::SetProxyAuthentication(
+    const ProxyServer& proxy,
+    std::optional<AuthCredentials> credentials) {
+  identity_proxy_endpoint_ = proxy.is_valid()
+                                 ? std::make_optional(proxy.host_port_pair())
+                                 : std::nullopt;
+  if (credentials && credentials->Empty()) {
+    credentials.reset();
+  }
+  if (configured_proxy_auth_ && configured_proxy_auth_->first == proxy &&
+      credentials && configured_proxy_auth_->second.Equals(*credentials)) {
+    return;
+  }
+  if (configured_proxy_auth_ && configured_proxy_auth_->first.is_http_like()) {
+    const auto& [previous, auth] = *configured_proxy_auth_;
+    const auto& hp = previous.host_port_pair();
+    http_auth_cache_.Remove(
+        url::SchemeHostPort(previous.is_https() ? "https" : "http", hp.host(),
+                            hp.port()),
+        HttpAuth::AUTH_PROXY, "", HttpAuth::AUTH_SCHEME_BASIC,
+        NetworkAnonymizationKey(), auth);
+  }
+  socks5_auth_.clear();
+  http_auth_cache_.SetConfiguredProxyCredentials(std::nullopt);
+  configured_proxy_auth_.reset();
+  if (!credentials || !proxy.is_valid()) {
+    return;
+  }
+  configured_proxy_auth_.emplace(proxy, *credentials);
+  if (proxy.is_socks()) {
+    socks5_auth_.emplace(proxy.host_port_pair(), *credentials);
+  } else if (proxy.is_http_like()) {
+    const auto& hp = proxy.host_port_pair();
+    http_auth_cache_.SetConfiguredProxyCredentials(
+        std::make_pair(url::SchemeHostPort(proxy.is_https() ? "https" : "http",
+                                           hp.host(), hp.port()),
+                       *credentials));
+    http_auth_cache_.Add(
+        url::SchemeHostPort(proxy.is_https() ? "https" : "http", hp.host(),
+                            hp.port()),
+        HttpAuth::AUTH_PROXY, "", HttpAuth::AUTH_SCHEME_BASIC,
+        NetworkAnonymizationKey(), "Basic realm=\"\"", *credentials, "/");
+  }
+}

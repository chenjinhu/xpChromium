+      blink::SetWebViewRegionalSettings({{"en-US", "en"}, "America/New_York"}));
+  CHECK(!blink::SetWebViewRegionalSettings({{"en_US"}, "UTC"}));
+  CHECK_EQ(blink::GetWebViewRegionalSettings()->languages.front(), "en-US");
+  std::cout << "PASS proxy API validation, IP region parsing, ICU "
+               "languages/timezones and immutable regional store\n";

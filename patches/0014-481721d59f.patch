+// An idempotent projection of sparse opaque color samples. Absolute logical
+// coordinates make overlapping subrectangles and encoders agree. Alpha,
+// transparent pixels and row padding are preserved.
+BLINK_COMMON_EXPORT void ProjectIdentityPixels(base::span<uint8_t> bytes,
+                                               size_t width,
+                                               size_t height,
+                                               size_t row_bytes,
+                                               int64_t origin_x,
+                                               int64_t origin_y,
+                                               bool bgra,
+                                               bool bottom_up,
+                                               uint64_t seed);
+
+// Both float and byte analyser APIs apply this before their native conversion.
+BLINK_COMMON_EXPORT double IdentityFrequency(double decibels,
+                                             uint64_t seed,
+                                             size_t index);
+BLINK_COMMON_EXPORT float IdentitySample(float sample,
+                                         uint64_t seed,
+                                         size_t index);
+
+}  // namespace blink::webview
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_WEBVIEW_IDENTITY_UTILS_H_

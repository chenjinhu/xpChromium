+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "content/public/browser/network_service_instance.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_util.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/cert_verifier/public/mojom/cert_verifier_service_factory.mojom.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "third_party/blink/public/common/webview/property_overrides.h"
+#include "third_party/blink/public/common/webview/regional_settings.h"
+namespace android_webview {
+namespace {
+content::StoragePartition* Partition(content::WebContents* contents) {
+  return contents->GetPrimaryMainFrame()->GetStoragePartition();
+}
+bool RegionalIp() {
+  return blink::WebViewPropertyOverrides().GetString(
+             "chromium.regional.mode") == "ip";
+}
+bool NeedsIp() {
+  return RegionalIp() || blink::WebViewPropertyOverrides().GetString(
+                             "chromium.geolocation.mode") == "ip";
+}
+bool HardRequirement() {
+  const blink::WebViewPropertyOverrides config;
+  return RegionalIp() ||
+         config.GetString("chromium.network.proxy_api").has_value() ||
+         config.GetBool("chromium.network.proxy_check") == true ||
+         config.GetBool("chromium.network.proxy_required") == true;
+}
+}  // namespace
+AwIdentityCoordinator& AwIdentityCoordinator::Get() {
+  static base::NoDestructor<AwIdentityCoordinator> value;
+  // Some callers query browser preferences before the startup file is loaded.
+  // Re-evaluate manual settings until the first navigation starts preparation.
+  if (value->state_ == State::kIdle) {
+    value->InitializeManual();
+  }
+  return *value;
+}
+AwIdentityCoordinator::AwIdentityCoordinator() = default;
+void AwIdentityCoordinator::InitializeManual() {
+  const blink::WebViewPropertyOverrides config;
+  if (config.GetString("chromium.regional.mode") == "manual") {
+    blink::WebViewRegionalSettings settings;
+    const auto languages = config.GetStringList("chromium.regional.languages");
+    settings.languages.assign(languages.begin(), languages.end());
+    settings.timezone =
+        config.GetString("chromium.regional.timezone").value_or("");
+    blink::SetWebViewRegionalSettings(std::move(settings));
+  }
+}
+AwIdentityCoordinator::~AwIdentityCoordinator() = default;
+bool AwIdentityCoordinator::active() const {
+  const blink::WebViewPropertyOverrides config;
+  return NeedsIp() || HardRequirement() ||
+         config.GetString("chromium.regional.mode") == "manual";
+}
+void AwIdentityCoordinator::Prepare(content::WebContents* contents,
+                                    base::OnceCallback<void(bool)> callback) {
+  if (state_ == State::kReady) {
+    ApplyNetwork(contents, std::move(callback));
+    return;
+  }
+  if (state_ == State::kFailed &&
+      base::TimeTicks::Now() - last_attempt_ < base::Seconds(30)) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), !HardRequirement()));
+    return;
+  }
+  pending_.push_back({contents->GetWeakPtr(), std::move(callback)});
+  if (state_ == State::kLoading) {
+    return;
+  }
+  state_ = State::kLoading;
+  last_attempt_ = base::TimeTicks::Now();
+  watchdog_.Start(FROM_HERE, base::Seconds(40),
+                  base::BindOnce(
+                      [](AwIdentityCoordinator* self) {
+                        self->weak_factory_.InvalidateWeakPtrs();
+                        self->Finish(false);
+                      },
+                      base::Unretained(this)));
+  active_contents_ = contents->GetWeakPtr();
+  if (!proxy_resolved_ && blink::WebViewPropertyOverrides().GetString(
+                              "chromium.network.proxy_api")) {
+    FetchProxy();
+  } else {
+    BeginNetworkChecks();
+  }
+}
+void AwIdentityCoordinator::Fetch(
+    const GURL& url,
+    scoped_refptr<network::SharedURLLoaderFactory> factory,
+    base::OnceCallback<void(std::optional<std::string>)> callback) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->do_not_prompt_for_login = true;
+  constexpr auto annotation =
+      net::DefineNetworkTrafficAnnotation("webview_identity_bootstrap", R"(
+    semantics {
+      sender: "WebView startup identity"
+      description: "Obtains an explicitly configured proxy, checks it, and resolves IP region before navigation."
+      trigger: "First navigation with an enabled startup identity setting, or retry after failure."
+      data: "HTTPS GET without cookies. Only the proxy API uses the isolated bootstrap context."
+      destination: OTHER
+      destination_other: "Configured HTTPS endpoint; IP lookup defaults to ipwho.is."
+    }
+    policy {
+      cookies_allowed: NO
+      setting: "Opt-in settings in /sdcard/xpChromium/fingerprint.json. Disabled by default."
+      policy_exception_justification: "A custom WebView startup setting."
+    })");
+  loader_ = network::SimpleURLLoader::Create(std::move(request), annotation);
+  loader_->SetTimeoutDuration(base::Seconds(10));
+  loader_->DownloadToString(factory.get(), std::move(callback), 65536);
+}
+void AwIdentityCoordinator::FetchProxy() {
+  const blink::WebViewPropertyOverrides config;
+  auto params = network::mojom::NetworkContextParams::New();
+  params->http_cache_enabled = false;
+  params->cert_verifier_params = content::GetCertVerifierParams(
+      cert_verifier::mojom::CertVerifierCreationParams::New());
+  // The isolated context is used only for this HTTPS proxy API. Its routing
+  // uses the optional static bootstrap proxy, otherwise native direct routing.
+  const AwNetworkPropertyPolicy bootstrap(config.NetworkProxy());
+  constexpr auto proxy_annotation = net::DefineNetworkTrafficAnnotation(
+      "webview_identity_bootstrap_proxy", R"(
+    semantics {
+      sender: "WebView proxy API bootstrap"
+      description: "Routes only the HTTPS proxy API request using the optional static bootstrap proxy."
+      trigger: "Explicit network.proxy_api startup setting."
+      data: "Proxy configuration."
+      destination: OTHER
+      destination_other: "The explicitly configured static proxy."
+    }
+    policy {
+      cookies_allowed: NO
+      setting: "Disabled unless network.proxy_api is configured."
+      policy_exception_justification: "A custom WebView startup setting."
+    })");
+  params->initial_proxy_config =
+      bootstrap.proxy_config()
+          ? net::ProxyConfigWithAnnotation(*bootstrap.proxy_config(),
+                                           proxy_annotation)
+          : net::ProxyConfigWithAnnotation::CreateDirect();
+  if (bootstrap.proxy_server()) {
+    if (auto username = config.GetValue("chromium.network.proxy_username")) {
+      params->proxy_authentication = network::mojom::ProxyAuthentication::New(
+          *bootstrap.proxy_server(),
+          net::AuthCredentials(
+              base::UTF8ToUTF16(*username),
+              base::UTF8ToUTF16(
+                  config.GetValue("chromium.network.proxy_password")
+                      .value_or(""))));
+    }
+  }
+  content::CreateNetworkContextInNetworkService(
+      bootstrap_context_.BindNewPipeAndPassReceiver(), std::move(params));
+  auto factory_params = network::mojom::URLLoaderFactoryParams::New();
+  factory_params->process_id = network::OriginatingProcessId::browser();
+  factory_params->is_trusted = true;
+  bootstrap_context_->CreateURLLoaderFactory(
+      bootstrap_factory_.BindNewPipeAndPassReceiver(),
+      std::move(factory_params));
+  Fetch(GURL(*config.GetString("chromium.network.proxy_api")),
+        base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+            bootstrap_factory_.get()),
+        base::BindOnce(&AwIdentityCoordinator::OnProxy,
+                       weak_factory_.GetWeakPtr()));
+}
+void AwIdentityCoordinator::OnProxy(std::optional<std::string> body) {
+  const auto proxy = body && loader_->NetError() == net::OK
+                         ? ParseAwProxyResponse(*body)
+                         : std::nullopt;
+  loader_.reset();
+  bootstrap_factory_.reset();
+  bootstrap_context_.reset();
+  const blink::WebViewPropertyOverrides config;
+  if (!proxy ||
+      !AwProxyConfigMonitor::GetInstance()->SetIdentityProxy(
+          proxy->uri,
+          proxy->username.value_or(
+              config.GetValue("chromium.network.proxy_username").value_or("")),
+          proxy->password.value_or(
+              config.GetValue("chromium.network.proxy_password")
+                  .value_or("")))) {
+    Finish(false);
+    return;
+  }
+  proxy_resolved_ = true;
+  AwProxyConfigMonitor::GetInstance()->FlushIdentityProxy(base::BindOnce(
+      &AwIdentityCoordinator::BeginNetworkChecks, weak_factory_.GetWeakPtr()));
+}
+void AwIdentityCoordinator::ApplyNetwork(
+    content::WebContents* contents,
+    base::OnceCallback<void(bool)> callback) {
+  auto* context = Partition(contents)->GetNetworkContext();
+  const auto regional = blink::GetWebViewRegionalSettings();
+  if (!regional->languages.empty()) {
+    context->SetAcceptLanguage(net::HttpUtil::GenerateAcceptLanguageHeader(
+        base::JoinString(regional->languages, ",")));
+  }
+  if (AwNetworkPropertyPolicy::Get().proxy_config()) {
+    context->SetProxyAuthentication(
+        AwProxyConfigMonitor::GetInstance()->IdentityAuthentication(),
+        base::BindOnce(std::move(callback),
+                       AwNetworkPropertyPolicy::Get().proxy_is_valid()));
+  } else {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), true));
+  }
+}
+void AwIdentityCoordinator::BeginNetworkChecks() {
+  if (!active_contents_) {
+    Finish(false);
+    return;
+  }
+  ApplyNetwork(active_contents_.get(),
+               base::BindOnce(
+                   [](base::WeakPtr<AwIdentityCoordinator> self, bool ok) {
+                     if (!self) {
+                       return;
+                     }
+                     if (ok) {
+                       self->CheckHealth();
+                     } else {
+                       self->Finish(false);
+                     }
+                   },
+                   weak_factory_.GetWeakPtr()));
+}
+void AwIdentityCoordinator::CheckHealth() {
+  if (!active_contents_) {
+    Finish(false);
+    return;
+  }
+  const blink::WebViewPropertyOverrides config;
+  if (config.GetBool("chromium.network.proxy_check") != true) {
+    FetchIp();
+    return;
+  }
+  Fetch(
+      GURL(config.GetString("chromium.network.proxy_check_url")
+               .value_or("https://ipwho.is/")),
+      Partition(active_contents_.get())->GetURLLoaderFactoryForBrowserProcess(),
+      base::BindOnce(&AwIdentityCoordinator::OnHealth,
+                     weak_factory_.GetWeakPtr()));
+}
+void AwIdentityCoordinator::OnHealth(std::optional<std::string> body) {
+  const bool ok = body && loader_->NetError() == net::OK;
+  loader_.reset();
+  if (!ok) {
+    Finish(false);
+    return;
+  }
+  FetchIp();
+}
+void AwIdentityCoordinator::FetchIp() {
+  if (!NeedsIp()) {
+    Finish(true);
+    return;
+  }
+  if (!active_contents_) {
+    Finish(false);
+    return;
+  }
+  const blink::WebViewPropertyOverrides config;
+  Fetch(
+      GURL(config.GetString("chromium.geolocation.endpoint")
+               .value_or("https://ipwho.is/")),
+      Partition(active_contents_.get())->GetURLLoaderFactoryForBrowserProcess(),
+      base::BindOnce(&AwIdentityCoordinator::OnIp, weak_factory_.GetWeakPtr()));
+}
+void AwIdentityCoordinator::OnIp(std::optional<std::string> body) {
+  ip_ = body && loader_->NetError() == net::OK ? ParseAwIpIdentity(*body)
+                                               : std::nullopt;
+  loader_.reset();
+  if (RegionalIp()) {
+    if (!ip_ || ip_->regional.timezone.empty() ||
+        ip_->regional.languages.empty() ||
+        !blink::SetWebViewRegionalSettings(ip_->regional)) {
+      Finish(false);
+      return;
+    }
+  }
+  Finish(ip_.has_value() || !RegionalIp());
+}
+void AwIdentityCoordinator::Finish(bool success) {
+  watchdog_.Stop();
+  loader_.reset();
+  state_ = success ? State::kReady : State::kFailed;
+  if (!success && blink::WebViewPropertyOverrides().GetString(
+                      "chromium.network.proxy_api")) {
+    proxy_resolved_ = false;
+  }
+  auto pending = std::move(pending_);
+  active_contents_.reset();
+  for (auto& item : pending) {
+    if (!item.contents || (!success && HardRequirement())) {
+      std::move(item.callback).Run(false);
+    } else {
+      ApplyNetwork(item.contents.get(), std::move(item.callback));
+    }
+  }
+}
+void AwIdentityCoordinator::Geolocation(
+    content::WebContents* contents,
+    base::OnceCallback<void(device::mojom::GeopositionResultPtr)> callback) {
+  if (!RegionalIp() && state_ == State::kReady &&
+      (!ip_ || !ip_->latitude || !ip_->longitude) &&
+      base::TimeTicks::Now() - last_attempt_ >= base::Seconds(30)) {
+    state_ = State::kIdle;
+  }
+  Prepare(
+      contents,
+      base::BindOnce(
+          [](base::WeakPtr<AwIdentityCoordinator> self,
+             base::OnceCallback<void(device::mojom::GeopositionResultPtr)> done,
+             bool ready) {
+            if (self && ready && self->ip_ && self->ip_->latitude &&
+                self->ip_->longitude) {
+              auto position = device::mojom::Geoposition::New();
+              position->latitude = *self->ip_->latitude;
+              position->longitude = *self->ip_->longitude;
+              position->accuracy =
+                  blink::WebViewPropertyOverrides()
+                      .GetDouble("chromium.geolocation.accuracy", 1000, 1e7)
+                      .value_or(50000);
+              position->timestamp = base::Time::Now();
+              position->is_precise = false;
+              std::move(done).Run(device::mojom::GeopositionResult::NewPosition(
+                  std::move(position)));
+            } else {
+              std::move(done).Run(device::mojom::GeopositionResult::NewError(
+                  device::mojom::GeopositionError::New(
+                      device::mojom::GeopositionErrorCode::kPositionUnavailable,
+                      "IP-based location is unavailable", "")));
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+}  // namespace android_webview

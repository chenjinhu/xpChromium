+#include "net/base/ip_address.h"
+#include "url/gurl.h"
+namespace net {
+bool IdentityAllowsUrl(const GURL& url,
+                       bool block_local,
+                       base::span<const uint16_t> blocked_ports) {
+  if (std::ranges::contains(blocked_ports, url.EffectiveIntPort())) {
+    return false;
+  }
+  if (!block_local) {
+    return true;
+  }
+  const std::string host = base::ToLowerASCII(url.HostNoBrackets());
+  if (host == "localhost" || host.ends_with(".localhost") ||
+      host.ends_with(".local")) {
+    return false;
+  }
+  IPAddress address;
+  return !address.AssignFromIPLiteral(host) || address.IsPubliclyRoutable();
+}
+}  // namespace net

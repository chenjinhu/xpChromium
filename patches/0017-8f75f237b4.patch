diff --git a/chrome/browser/android/fingerprint/fingerprint_startup.cc b/chrome/browser/android/fingerprint/fingerprint_startup.cc
new file mode 100644
index 0000000000000000000000000000000000000000..488cf5f944d1b892c57350f9d08294940b293fbd
--- /dev/null
+++ b/chrome/browser/android/fingerprint/fingerprint_startup.cc
@@ -0,0 +1,161 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/android/fingerprint/fingerprint_startup.h"
+
+#include <mutex>
+
+#include "android_webview/browser/aw_fingerprint_config_file.h"
+#include "android_webview/browser/aw_identity_coordinator.h"
+#include "android_webview/browser/aw_ip_geolocation_context.h"
+#include "android_webview/browser/network_service/aw_network_property_policy.h"
+#include "android_webview/browser/network_service/aw_proxy_config_monitor.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/android/fingerprint/identity_navigation_throttle.h"
+#include "content/public/browser/device_service.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "services/device/public/mojom/device_service.mojom.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "third_party/blink/public/common/renderer_preferences/renderer_preferences.h"
+#include "third_party/blink/public/common/webview/fingerprint_config.h"
+#include "third_party/blink/public/common/webview/property_overrides.h"
+#include "third_party/blink/public/common/webview/regional_settings.h"
+namespace xpchromium {
+void InitializeFingerprint() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    std::string error;
+    const auto status = android_webview::ApplyFingerprintConfigFile(
+        base::FilePath(android_webview::kFingerprintConfigPath), error);
+    if (status == android_webview::FingerprintFileStatus::kError) {
+      LOG(ERROR) << "xpChromium configuration rejected; network blocked: "
+                 << error;
+    } else if (status == android_webview::FingerprintFileStatus::kLoaded) {
+      LOG(INFO) << "xpChromium fingerprint configuration loaded";
+    } else {
+      LOG(INFO) << "xpChromium fingerprint file absent; native defaults";
+    }
+    blink::FreezeWebViewFingerprint();
+    if (HasIdentityProxy() || blink::WebViewPropertyOverrides().GetBool(
+                                  "chromium.network.block_local") == true) {
+      base::CommandLine::ForCurrentProcess()->AppendSwitch("disable-quic");
+    }
+  });
+}
+void ConfigureNetwork(network::mojom::NetworkContextParams& params) {
+  android_webview::AwIdentityCoordinator::Get();
+  const blink::WebViewPropertyOverrides identity;
+  const auto regional_mode = identity.GetString("chromium.regional.mode");
+  params.identity_force_accept_language =
+      regional_mode == "ip" ||
+      (regional_mode == "manual" &&
+       !identity.GetStringList("chromium.regional.languages").empty());
+  if (auto language = blink::GetWebViewRegionalAcceptLanguage()) {
+    params.accept_language = *language;
+  }
+  params.identity_block_local =
+      identity.GetBool("chromium.network.block_local").value_or(false);
+  for (int port : identity.GetIntegerList("chromium.network.blocked_ports")) {
+    params.identity_blocked_ports.push_back(static_cast<uint16_t>(port));
+  }
+  if (!params.initial_ssl_config) {
+    params.initial_ssl_config = network::mojom::SSLConfig::New();
+  }
+  for (int cipher :
+       identity.GetIntegerList("chromium.network.tls_disabled_ciphers")) {
+    params.initial_ssl_config->disabled_cipher_suites.push_back(
+        static_cast<uint16_t>(cipher));
+  }
+  if (auto dnt = identity.GetBool("chromium.privacy.doNotTrack")) {
+    params.identity_do_not_track = *dnt ? 1 : 0;
+  }
+  if (auto ua = identity.UserAgent()) {
+    params.identity_user_agent = *ua;
+  }
+  if (auto xrw = identity.RequestedWith()) {
+    params.identity_requested_with = *xrw;
+  }
+  if (HasIdentityProxy()) {
+    // Replace Chrome's profile proxy monitor only when a pinned identity proxy
+    // is configured. The shared monitor handles API resolution and restarts.
+    params.proxy_config_client_receiver.reset();
+    android_webview::AwProxyConfigMonitor::GetInstance()
+        ->AddProxyToNetworkContextParams(&params);
+  }
+}
+bool HasIdentityProxy() {
+  return android_webview::AwNetworkPropertyPolicy::Get()
+      .proxy_config()
+      .has_value();
+}
+void UpdateRendererPreferences(blink::RendererPreferences& prefs) {
+  android_webview::AwIdentityCoordinator::Get();
+  const auto regional = blink::GetWebViewRegionalSettings();
+  if (!regional->languages.empty()) {
+    prefs.accept_languages = base::JoinString(regional->languages, ",");
+  }
+  android_webview::AwNetworkPropertyPolicy::Get().ApplyWebRtcPolicy(prefs);
+  if (auto dnt = blink::WebViewPropertyOverrides().GetBool(
+          "chromium.privacy.doNotTrack")) {
+    prefs.enable_do_not_track = *dnt;
+  }
+}
+void AddIdentityNavigationThrottle(
+    content::NavigationThrottleRegistry& registry) {
+  if (android_webview::AwIdentityCoordinator::Get().active()) {
+    registry.AddThrottle(
+        std::make_unique<IdentityNavigationThrottle>(registry));
+  }
+}
+device::mojom::GeolocationContext* GetGeolocationContext(
+    content::WebContents* contents) {
+  const blink::WebViewPropertyOverrides config;
+  if (!config.enabled() ||
+      config.GetString("chromium.geolocation.mode") != "ip") {
+    return nullptr;
+  }
+  static const char kContextKey = 0;
+  auto* context = static_cast<android_webview::AwIpGeolocationContext*>(
+      contents->GetUserData(&kContextKey));
+  if (!context) {
+    mojo::Remote<device::mojom::GeolocationContext> device_context;
+    content::GetDeviceService().BindGeolocationContext(
+        device_context.BindNewPipeAndPassReceiver());
+    auto owned = std::make_unique<android_webview::AwIpGeolocationContext>(
+        contents->GetPrimaryMainFrame()
+            ->GetStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess(),
+        std::move(device_context),
+        GURL(config.GetString("chromium.geolocation.endpoint")
+                 .value_or("https://ipwho.is/")),
+        config.GetDouble("chromium.geolocation.accuracy", 1000, 1e7)
+            .value_or(50000),
+        base::BindRepeating(
+            [](base::WeakPtr<content::WebContents> contents,
+               base::OnceCallback<void(device::mojom::GeopositionResultPtr)>
+                   callback) {
+              if (contents) {
+                android_webview::AwIdentityCoordinator::Get().Geolocation(
+                    contents.get(), std::move(callback));
+              } else {
+                std::move(callback).Run(
+                    device::mojom::GeopositionResult::NewError(
+                        device::mojom::GeopositionError::New(
+                            device::mojom::GeopositionErrorCode::
+                                kPositionUnavailable,
+                            "WebContents closed", "")));
+              }
+            },
+            contents->GetWeakPtr()));
+    context = owned.get();
+    contents->SetUserData(&kContextKey, std::move(owned));
+  }
+  return context;
+}
+}  // namespace xpchromium

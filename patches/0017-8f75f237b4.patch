+#ifndef CHROME_BROWSER_ANDROID_FINGERPRINT_IDENTITY_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_ANDROID_FINGERPRINT_IDENTITY_NAVIGATION_THROTTLE_H_
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/common/renderer_configuration.mojom.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+namespace xpchromium {
+class IdentityNavigationThrottle final : public content::NavigationThrottle {
+ public:
+  explicit IdentityNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~IdentityNavigationThrottle() override;
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  ThrottleCheckResult WillProcessResponse() override;
+  ThrottleCheckResult WillCommitWithoutUrlLoader() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult Prepare(bool committing);
+  ThrottleCheckResult SyncRenderer();
+  void OnPrepared(bool ready);
+  void OnApplied(bool applied);
+  void Fail();
+  void SetLanguageHeader();
+  bool committing_ = false;
+  base::OneShotTimer timer_;
+  mojo::AssociatedRemote<chrome::mojom::RendererConfiguration> renderer_;
+  base::WeakPtrFactory<IdentityNavigationThrottle> weak_factory_{this};
+};
+}  // namespace xpchromium
+#endif

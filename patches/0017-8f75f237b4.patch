+TEST_F(NetworkSessionIdentityTest,
+       BrowserHeadersReplaceRemoveAndKeepNativeDefaults) {
+  HttpRequestHeaders headers;
+  headers.SetHeader("x-requested-with", "page-supplied");
+  headers.SetHeader("User-Agent", "native-UA");
+  headers.SetHeader("Authorization", "must-be-preserved");
+  ApplyIdentityRequestHeaders(headers, -1, std::nullopt);
+  EXPECT_EQ(headers.GetHeader("X-Requested-With"), "page-supplied");
+  EXPECT_EQ(headers.GetHeader("User-Agent"), "native-UA");
+  ApplyIdentityRequestHeaders(headers, -1, std::nullopt,
+                              std::string("test.browser"),
+                              std::string("configured-UA"));
+  EXPECT_EQ(headers.GetHeader("X-Requested-With"), "test.browser");
+  EXPECT_EQ(headers.GetHeader("User-Agent"), "configured-UA");
+  EXPECT_EQ(headers.GetHeader("Authorization"), "must-be-preserved");
+  ApplyIdentityRequestHeaders(headers, -1, std::nullopt, std::string(""));
+  EXPECT_FALSE(headers.HasHeader("X-Requested-With"));
+  EXPECT_EQ(headers.GetHeader("User-Agent"), "configured-UA");
+  ApplyIdentityRequestHeaders(headers, -1, std::nullopt);
+  EXPECT_FALSE(headers.HasHeader("X-Requested-With"));
+}

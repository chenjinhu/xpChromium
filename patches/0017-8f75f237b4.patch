diff --git a/chrome/browser/android/fingerprint/identity_navigation_throttle.cc b/chrome/browser/android/fingerprint/identity_navigation_throttle.cc
new file mode 100644
index 0000000000000000000000000000000000000000..985f36b485cc62967192665bea6f1a2b04945e42
--- /dev/null
+++ b/chrome/browser/android/fingerprint/identity_navigation_throttle.cc
@@ -0,0 +1,123 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/android/fingerprint/identity_navigation_throttle.h"
+
+#include "android_webview/browser/aw_identity_coordinator.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "ipc/ipc_channel_proxy.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_util.h"
+#include "third_party/blink/public/common/webview/regional_settings.h"
+namespace xpchromium {
+IdentityNavigationThrottle::IdentityNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : NavigationThrottle(registry) {}
+IdentityNavigationThrottle::~IdentityNavigationThrottle() = default;
+const char* IdentityNavigationThrottle::GetNameForLogging() {
+  return "IdentityNavigationThrottle";
+}
+content::NavigationThrottle::ThrottleCheckResult
+IdentityNavigationThrottle::WillStartRequest() {
+  return Prepare(false);
+}
+content::NavigationThrottle::ThrottleCheckResult
+IdentityNavigationThrottle::WillCommitWithoutUrlLoader() {
+  return Prepare(true);
+}
+content::NavigationThrottle::ThrottleCheckResult
+IdentityNavigationThrottle::Prepare(bool committing) {
+  committing_ = committing;
+  timer_.Start(FROM_HERE, base::Seconds(45),
+               base::BindOnce(&IdentityNavigationThrottle::Fail,
+                              weak_factory_.GetWeakPtr()));
+  android_webview::AwIdentityCoordinator::Get().Prepare(
+      navigation_handle()->GetWebContents(),
+      base::BindOnce(&IdentityNavigationThrottle::OnPrepared,
+                     weak_factory_.GetWeakPtr()));
+  return DEFER;
+}
+void IdentityNavigationThrottle::SetLanguageHeader() {
+  const auto regional = blink::GetWebViewRegionalSettings();
+  if (!regional->languages.empty()) {
+    navigation_handle()->SetRequestHeader(
+        "Accept-Language", net::HttpUtil::GenerateAcceptLanguageHeader(
+                               base::JoinString(regional->languages, ",")));
+  }
+}
+content::NavigationThrottle::ThrottleCheckResult
+IdentityNavigationThrottle::WillRedirectRequest() {
+  SetLanguageHeader();
+  return PROCEED;
+}
+void IdentityNavigationThrottle::OnPrepared(bool ready) {
+  if (!ready) {
+    Fail();
+    return;
+  }
+  if (committing_) {
+    const auto result = SyncRenderer();
+    if (result.action() == PROCEED) {
+      timer_.Stop();
+      Resume();
+    } else if (result.action() != DEFER) {
+      timer_.Stop();
+      CancelDeferredNavigation(result);
+    }
+  } else {
+    SetLanguageHeader();
+    timer_.Stop();
+    Resume();
+  }
+}
+content::NavigationThrottle::ThrottleCheckResult
+IdentityNavigationThrottle::WillProcessResponse() {
+  return SyncRenderer();
+}
+content::NavigationThrottle::ThrottleCheckResult
+IdentityNavigationThrottle::SyncRenderer() {
+  const auto regional = blink::GetWebViewRegionalSettings();
+  if (regional->languages.empty() && regional->timezone.empty()) {
+    return PROCEED;
+  }
+  auto* frame = navigation_handle()->GetRenderFrameHost();
+  if (!frame) {
+    return PROCEED;  // Download or HTTP 204; no document commits.
+  }
+  auto* channel = frame->GetProcess()->GetChannel();
+  if (!channel) {
+    return {CANCEL, net::ERR_FAILED};
+  }
+  channel->GetRemoteAssociatedInterface(&renderer_);
+  renderer_.set_disconnect_handler(base::BindOnce(
+      &IdentityNavigationThrottle::Fail, weak_factory_.GetWeakPtr()));
+  timer_.Start(FROM_HERE, base::Seconds(5),
+               base::BindOnce(&IdentityNavigationThrottle::Fail,
+                              weak_factory_.GetWeakPtr()));
+  renderer_->SetRegionalIdentity(
+      regional->languages, regional->timezone,
+      base::BindOnce(&IdentityNavigationThrottle::OnApplied,
+                     weak_factory_.GetWeakPtr()));
+  return DEFER;
+}
+void IdentityNavigationThrottle::OnApplied(bool applied) {
+  if (!applied) {
+    Fail();
+    return;
+  }
+  timer_.Stop();
+  renderer_.reset();
+  Resume();
+}
+void IdentityNavigationThrottle::Fail() {
+  timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  renderer_.reset();
+  CancelDeferredNavigation({CANCEL, net::ERR_BLOCKED_BY_ADMINISTRATOR});
+}
+}  // namespace xpchromium

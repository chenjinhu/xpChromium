diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_random.h b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_random.h
index 25b4619ce8137c5bdb7ad4fb54333fdf3d74924d..154dd963e29baf74c5cc15ca1ac0e08fa18cd75b 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_random.h
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_random.h
@@ -5,13 +5,23 @@
 #ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_BASE_RENDERING_CONTEXT_RANDOM_H_
 #define THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_BASE_RENDERING_CONTEXT_RANDOM_H_
 
+#include <array>
+#include <cstdint>
+
 #include "base/rand_util.h"
 
 namespace blink {
 
-// Independent integer offset for each coordinate/dimension of a fillRect call.
-inline int GetCanvasRandomInt() {
-  return base::RandInt(-1, 1);
+// One uniform sample over the 81 equally likely combinations gives four
+// independent offsets in [-1, 1], without four calls to the random source.
+inline std::array<int, 4> GetCanvasFillRectNoise() {
+  uint64_t sample = base::RandGenerator(81);
+  std::array<int, 4> offsets;
+  for (int& offset : offsets) {
+    offset = static_cast<int>(sample % 3) - 1;
+    sample /= 3;
+  }
+  return offsets;
 }
 
 }  // namespace blink
diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc b/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc
index 157341cc3792eff8959761b5172f937174f305f2..ecdf30c5723b7e05409a0f70ea9793318b51e99a 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/canvas_2d_recorder_context.cc
@@ -1760,11 +1760,12 @@ void Canvas2DRecorderContext::fillRect(double x,
   CanvasRenderingContext::AdjustRectForCanvas(x, y, width, height);
   if (RuntimeEnabledFeatures::CanvasFillRectNoiseEnabled() && width != 0 &&
       height != 0) {
-    x += GetCanvasRandomInt();
-    y += GetCanvasRandomInt();
+    const auto offsets = GetCanvasFillRectNoise();
+    x += offsets[0];
+    y += offsets[1];
     // Keep tiny rectangles non-negative and zero-size draws unchanged.
-    width = std::max(0.0, width + GetCanvasRandomInt());
-    height = std::max(0.0, height + GetCanvasRandomInt());
+    width = std::max(0.0, width + offsets[2]);
+    height = std::max(0.0, height + offsets[3]);
   }
   // Clamp to float to avoid float cast overflow when used as SkScalar.
   gfx::RectF rect(ClampTo<float>(x), ClampTo<float>(y), ClampTo<float>(width),
diff --git a/webview_custom/README.md b/webview_custom/README.md
index fb9b1b70739e8140235cccef7b427e604f2d5cb5..68b76abb32e15199fcbe7096bbe092b29a7f71b9 100644
--- a/webview_custom/README.md
+++ b/webview_custom/README.md
@@ -8,11 +8,12 @@
 ## WebView 修改
 
 1. `Window.window`、`Window.document` 从 `LegacyUnforgeable` 改为 `Replaceable`，保留跨域限制与缓存属性。
-2. `fillRect` 为 x、y、width、height 分别生成独立的 `[-1, 1]` 整数偏移。原包缺少随机函数头文件，经用户授权使用 Chromium `base::RandInt` 补齐。
-3. 保留原始无效参数处理；零宽高不加噪，负尺寸先按上游逻辑归一化，扰动后的宽高下限为 0。
-4. `CanvasFillRectNoise` 默认开启，可用 `--disable-blink-features=CanvasFillRectNoise` 恢复上游 Canvas 绘制。此修改影响 HTML Canvas 和 OffscreenCanvas 的共用绘制入口；每次绘制可能得到不同图像。
+2. 为 `Window.navigator` 补上 `Replaceable`，修复原包直接赋值 Proxy 的示例与只读 IDL 不一致的问题。
+3. `fillRect` 为 x、y、width、height 分别生成独立的 `[-1, 1]` 整数偏移。原包缺少随机函数头文件，经用户授权使用 Chromium `base::RandGenerator(81)` 一次均匀采样，拆成四个三进制位 补齐。
+4. 保留原始无效参数处理；零宽高不加噪，负尺寸先按上游逻辑归一化，扰动后的宽高下限为 0。
+5. `CanvasFillRectNoise` 默认开启，可用 `--disable-blink-features=CanvasFillRectNoise` 恢复上游 Canvas 绘制。此修改影响 HTML Canvas 和 OffscreenCanvas 的共用绘制入口；每次绘制可能得到不同图像。
 
-`navigator`、`screen` 在输入包中没有新的功能实现，当前版本的配置属性保持原样。输入包没有 WebGL 随机化或无限 debugger 处理源码，这两项未实现。
+输入包的 `navigator` 修改只有注释，审查后补齐赋值支持；`screen` 已有 `Replaceable`，无需修改。输入包没有 WebGL 随机化或无限 debugger 处理源码，这两项未实现。
 
 ## 桌面 Chrome 修改
 
@@ -22,6 +23,8 @@
 
 ## 验证
 
+`python3 webview_custom/test_noise.py` 使用可控随机源，穷举检查生产头文件的全部 81 种输出、各轴分布和每次调用的采样次数。此测试不需要 Android 设备。
+
 `smoke.html` 可在使用此 WebView 的 Android 测试应用中加载，检查对象替换、跨域限制、Canvas 扰动范围、零尺寸和非法参数。正常模式应显示全部 PASS。关闭噪声开关后加载 `smoke.html?noise=off` 检查上游绘制恢复。没有连接 Android 设备时，不将编译或 APK 签名检查视为运行测试通过。
 
 增量编译时使用：
diff --git a/webview_custom/smoke.html b/webview_custom/smoke.html

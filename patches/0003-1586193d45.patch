+        assert(w[property] === replacement, property + ' assignment was ignored');
+        assert(Object.getOwnPropertyDescriptor(w, property).configurable,
+               property + ' must remain configurable');
       }
       assert(!Reflect.defineProperty(w, 'location', {value: {}}),
              'location must remain protected');
@@ -50,23 +52,37 @@
     }
   });
 
-  await test('Cross-origin document remains protected', async () => {
+  await test('Cross-origin window/document/navigator remain protected', async () => {
     const frame = document.createElement('iframe');
     frame.sandbox = 'allow-scripts';
     frame.srcdoc = '<!doctype html><title>opaque origin</title>';
-    const loaded = new Promise(resolve => frame.onload = resolve);
+    let timer;
+    const loaded = new Promise((resolve, reject) => {
+      timer = setTimeout(() => reject(new Error('iframe load timed out')), 15000);
+      frame.onload = () => { clearTimeout(timer); resolve(); };
+      frame.onerror = () => { clearTimeout(timer); reject(new Error('iframe load failed')); };
+    });
     document.body.appendChild(frame);
     try {
       await loaded;
+      const remote = frame.contentWindow;
+      assert(remote.window === remote, 'cross-origin window getter changed');
+      for (const property of ['document', 'navigator']) {
+        let denied = false;
+        try { void remote[property]; }
+        catch (error) { denied = error.name === 'SecurityError'; }
+        assert(denied, 'cross-origin ' + property + ' read was allowed');
+        denied = false;
+        try { remote[property] = {}; }
+        catch (error) { denied = error.name === 'SecurityError'; }
+        assert(denied, 'cross-origin ' + property + ' write was allowed');
+      }
       let denied = false;
-      try { void frame.contentWindow.document; }
-      catch (error) { denied = error.name === 'SecurityError'; }
-      assert(denied, 'cross-origin document read was allowed');
-      denied = false;
-      try { frame.contentWindow.document = {}; }
+      try { remote.window = {}; }
       catch (error) { denied = error.name === 'SecurityError'; }
-      assert(denied, 'cross-origin document write was allowed');
+      assert(denied, 'cross-origin window write was allowed');
     } finally {
+      clearTimeout(timer);
       frame.remove();
     }
   });
diff --git a/webview_custom/test_noise.py b/webview_custom/test_noise.py
new file mode 100644
index 0000000000000000000000000000000000000000..e2352b293c8667cc16e99b2d1c1fb9c70bb186a6
--- /dev/null
+++ b/webview_custom/test_noise.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Exhaustively test production noise mapping with an injected random source."""
+
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    compiler = shutil.which('clang++') or shutil.which('g++')
+    if not compiler:
+        raise SystemExit('A host C++ compiler is required')
+    with tempfile.TemporaryDirectory(prefix='canvas-noise-test-') as temporary:
+        temporary = Path(temporary)
+        stub = temporary / 'base' / 'rand_util.h'
+        stub.parent.mkdir()
+        stub.write_text('''#pragma once
+#include <cstdint>
+namespace base { uint64_t RandGenerator(uint64_t range); }
+''')
+        source = temporary / 'noise_test.cc'
+        source.write_text('''#include <array>
+#include <cstddef>
+#include <cassert>
+#include <cstdint>
+#include <set>
+#include "third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_random.h"
+
+namespace {
+uint64_t next_sample;
+int calls;
+}
+
+namespace base {
+uint64_t RandGenerator(uint64_t range) {
+  assert(range == 81);
+  ++calls;
+  return next_sample;
+}
+}
+
+int main() {
+  std::set<std::array<int, 4>> combinations;
+  std::array<std::array<int, 3>, 4> counts{};
+  for (next_sample = 0; next_sample < 81; ++next_sample) {
+    const int before = calls;
+    const auto offsets = blink::GetCanvasFillRectNoise();
+    assert(calls == before + 1);
+    assert(combinations.insert(offsets).second);
+    for (std::size_t axis = 0; axis < offsets.size(); ++axis) {
+      assert(offsets[axis] >= -1 && offsets[axis] <= 1);
+      ++counts[axis][offsets[axis] + 1];
+    }
+  }
+  assert(combinations.size() == 81);
+  for (const auto& axis : counts)
+    for (int count : axis)
+      assert(count == 27);
+}
+''')
+        binary = temporary / 'noise_test'
+        subprocess.run([compiler, '-std=c++17', '-Wall', '-Wextra', '-Werror',
+                        '-I', str(temporary), '-I', str(root), str(source),
+                        '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+    print('PASS: 81 unique combinations; uniform axes; one random call per draw')
+
+
+if __name__ == '__main__':
+    main()

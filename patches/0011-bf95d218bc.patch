diff --git a/third_party/blink/common/webview/fingerprint_config.cc b/third_party/blink/common/webview/fingerprint_config.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7c2abd5758446e300b9ffe10c39454c215273d84
--- /dev/null
+++ b/third_party/blink/common/webview/fingerprint_config.cc
@@ -0,0 +1,301 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/webview/fingerprint_config.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/synchronization/lock.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace blink {
+namespace {
+constexpr size_t kMaxConfigBytes = 32768;
+enum class Kind {
+  kString,
+  kHeader,
+  kAscii,
+  kBool,
+  kInt,
+  kNumber,
+  kBrands,
+  kProxy,
+  kIPv4
+};
+struct Field {
+  std::string_view key;
+  Kind kind;
+  double minimum = 0;
+  double maximum = 0;
+};
+constexpr Field kFields[] = {
+    {"navigator.useragent", Kind::kHeader},
+    {"config.x_requested_with", Kind::kHeader},
+    {"network.proxy", Kind::kProxy},
+    {"navigator.hardwareConcurrency", Kind::kInt, 1, 1024},
+    {"navigator.deviceMemory", Kind::kNumber, 0.125, 1024},
+    {"navigator.maxTouchPoints", Kind::kInt, 0, 100},
+    {"navigator.cookieEnabled", Kind::kBool},
+    {"navigator.vendor", Kind::kString},
+    {"navigator.productSub", Kind::kString},
+    {"navigator.platform", Kind::kString},
+    {"navigator.userAgentMeta.brands", Kind::kBrands},
+    {"navigator.userAgentMeta.fullVersionList", Kind::kBrands},
+    {"navigator.userAgentMeta.mobile", Kind::kBool},
+    {"navigator.userAgentMeta.wow64", Kind::kBool},
+    {"navigator.userAgentMeta.platform", Kind::kAscii},
+    {"navigator.userAgentMeta.platformVersion", Kind::kAscii},
+    {"navigator.userAgentMeta.architecture", Kind::kAscii},
+    {"navigator.userAgentMeta.model", Kind::kAscii},
+    {"navigator.userAgentMeta.bitness", Kind::kAscii},
+    {"navigator.userAgentMeta.fullVersion", Kind::kAscii},
+    {"navigator.battery.charging", Kind::kBool},
+    {"navigator.battery.chargingTime", Kind::kNumber, 0, 1e15},
+    {"navigator.battery.dischargingTime", Kind::kNumber, 0, 1e15},
+    {"navigator.battery.level", Kind::kNumber, 0, 1},
+    {"navigator.bluetooth", Kind::kBool},
+    {"navigator.connection.type", Kind::kAscii},
+    {"navigator.connection.effectiveType", Kind::kAscii},
+    {"navigator.connection.downlinkMax", Kind::kNumber, 0, 1e9},
+    {"navigator.connection.downlink", Kind::kNumber, 0, 1e9},
+    {"navigator.connection.rtt", Kind::kInt, 0, 2147483647},
+    {"document.clientWidth", Kind::kInt, 0, 100000},
+    {"document.clientHeight", Kind::kInt, 0, 100000},
+    {"window.innerWidth", Kind::kInt, 0, 100000},
+    {"window.innerHeight", Kind::kInt, 0, 100000},
+    {"window.outerWidth", Kind::kInt, 0, 100000},
+    {"window.outerHeight", Kind::kInt, 0, 100000},
+    {"window.devicePixelRatio", Kind::kNumber, 0.01, 100},
+    {"screen.width", Kind::kInt, 0, 100000},
+    {"screen.height", Kind::kInt, 0, 100000},
+    {"screen.availWidth", Kind::kInt, 0, 100000},
+    {"screen.availHeight", Kind::kInt, 0, 100000},
+    {"screen.colorDepth", Kind::kInt, 1, 128},
+    {"webgl.unmasked_vendor", Kind::kString},
+    {"webgl.unmasked_renderer", Kind::kString},
+    {"audio.randomDouble", Kind::kNumber, -1e9, 1e9},
+    {"canvas.toDataUrl.randomDouble", Kind::kNumber, -1e9, 1e9},
+    {"canvas.fillRectNoise", Kind::kBool},
+    {"webrtc.public_ip", Kind::kIPv4},
+    {"webrtc.private_ip", Kind::kIPv4},
+    {"webrtc.sdp_redact", Kind::kBool},
+};
+
+struct ConfigState {
+  base::Lock lock;
+  bool frozen = false;
+  std::shared_ptr<const WebViewFingerprintConfig> snapshot =
+      std::make_shared<WebViewFingerprintConfig>();
+};
+
+ConfigState& State() {
+  static base::NoDestructor<ConfigState> state;
+  return *state;
+}
+
+bool ValidIPv4(std::string_view text) {
+  for (int i = 0; i < 4; ++i) {
+    size_t dot = text.find('.');
+    auto part = text.substr(0, dot);
+    unsigned number;
+    if (part.empty() || part.size() > 3 ||
+        (part.size() > 1 && part.front() == '0') ||
+        !std::all_of(part.begin(), part.end(),
+                     [](unsigned char c) { return c >= '0' && c <= '9'; }) ||
+        !base::StringToUint(part, &number) || number > 255) {
+      return false;
+    }
+    if (i == 3) {
+      return dot == std::string_view::npos;
+    }
+    if (dot == std::string_view::npos) {
+      return false;
+    }
+    text.remove_prefix(dot + 1);
+  }
+  return false;
+}
+
+bool Convert(const Field& field,
+             const base::Value& value,
+             std::string& output) {
+  if (field.kind == Kind::kBool) {
+    if (!value.is_bool()) {
+      return false;
+    }
+    output = value.GetBool() ? "1" : "0";
+    return true;
+  }
+  if (field.kind == Kind::kInt || field.kind == Kind::kNumber) {
+    if (!value.is_int() && !value.is_double()) {
+      return false;
+    }
+    const double number = value.GetDouble();
+    if (!std::isfinite(number) || number < field.minimum ||
+        number > field.maximum ||
+        (field.kind == Kind::kInt && std::floor(number) != number)) {
+      return false;
+    }
+    output = field.kind == Kind::kInt
+                 ? base::NumberToString(static_cast<int>(number))
+                 : base::NumberToString(number);
+    return true;
+  }
+  if (field.kind == Kind::kBrands) {
+    if (!value.is_list() || value.GetList().empty() ||
+        value.GetList().size() > 16) {
+      return false;
+    }
+    for (const auto& item : value.GetList()) {
+      if (!item.is_dict() || item.GetDict().size() != 2) {
+        return false;
+      }
+      const auto* brand = item.GetDict().FindString("brand");
+      const auto* version = item.GetDict().FindString("version");
+      auto valid = [](const std::string* text) {
+        return text && !text->empty() && text->size() <= 128 &&
+               std::all_of(text->begin(), text->end(), [](unsigned char c) {
+                 return c >= 32 && c <= 126 && c != ',' && c != '&';
+               });
+      };
+      if (!valid(brand) || !valid(version)) {
+        return false;
+      }
+      if (!output.empty()) {
+        output += '&';
+      }
+      output += *brand + "," + *version;
+    }
+    return true;
+  }
+  if (!value.is_string()) {
+    return false;
+  }
+  output = value.GetString();
+  if (output.size() > 4096 || output.find('\0') != std::string::npos) {
+    return false;
+  }
+  if (field.kind == Kind::kAscii &&
+      !std::all_of(output.begin(), output.end(),
+                   [](unsigned char c) { return c >= 32 && c <= 126; })) {
+    return false;
+  }
+  if (field.kind == Kind::kHeader &&
+      !std::all_of(output.begin(), output.end(), [](unsigned char c) {
+        return c == '\t' || (c >= 32 && c != 127);
+      })) {
+    return false;
+  }
+  if (field.key == "navigator.useragent" && output.empty()) {
+    return false;
+  }
+  if (field.kind == Kind::kIPv4 && !ValidIPv4(output)) {
+    return false;
+  }
+  if (field.kind == Kind::kProxy) {
+    if (!output.starts_with("http://") && !output.starts_with("https://") &&
+        !output.starts_with("socks5://")) {
+      return false;
+    }
+    // SOCKS5 is not a standard GURL scheme. Validate its authority through an
+    // HTTP URL; the actual endpoint is still parsed by Chromium's net stack.
+    const GURL url(output.starts_with("socks5://")
+                       ? "http://" + output.substr(9)
+                       : output);
+    if ((!url.SchemeIs("http") && !url.SchemeIs("https") &&
+         !url.SchemeIs("socks5")) ||
+        !url.is_valid() || url.host().empty() || url.has_username() ||
+        url.has_password() || url.has_query() || url.has_ref() ||
+        (url.has_port() && url.IntPort() <= 0) ||
+        !std::all_of(output.begin(), output.end(),
+                     [](unsigned char c) { return c > 32 && c < 127; }) ||
+        output.find_first_of("\\,;= \t\r\n") != std::string::npos ||
+        output.substr(output.find("://") + 3).find('/') != std::string::npos) {
+      return false;
+    }
+  }
+  if (field.key == "navigator.connection.type") {
+    constexpr std::string_view types[] = {"bluetooth", "cellular", "ethernet",
+                                          "none",      "other",    "unknown",
+                                          "wifi",      "wimax"};
+    if (std::find(std::begin(types), std::end(types), output) ==
+        std::end(types)) {
+      return false;
+    }
+  }
+  if (field.key == "navigator.connection.effectiveType" &&
+      output != "slow-2g" && output != "2g" && output != "3g" &&
+      output != "4g") {
+    return false;
+  }
+  return true;
+}
+}  // namespace
+
+std::optional<std::string> WebViewFingerprintConfig::Find(
+    std::string_view name) const {
+  auto it = values.find(name);
+  return it == values.end() ? std::nullopt : std::make_optional(it->second);
+}
+
+std::string ConfigureWebViewFingerprint(std::string_view json) {
+  if (json.size() > kMaxConfigBytes) {
+    return "Fingerprint JSON exceeds 32768 bytes";
+  }
+  auto root = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root || root->size() != 3 || root->FindInt("version") != 1 ||
+      !root->FindBool("enabled").has_value() || !root->FindDict("settings")) {
+    return "Expected version:1, enabled:boolean and settings:object";
+  }
+  auto next = std::make_shared<WebViewFingerprintConfig>();
+  next->enabled = *root->FindBool("enabled");
+  for (const auto [key, value] : *root->FindDict("settings")) {
+    auto field =
+        std::find_if(std::begin(kFields), std::end(kFields),
+                     [&](const Field& item) { return item.key == key; });
+    if (field == std::end(kFields)) {
+      return "Unknown fingerprint setting: " + key;
+    }
+    std::string converted;
+    if (!Convert(*field, value, converted)) {
+      return "Invalid type or value for fingerprint setting: " + key;
+    }
+    next->values.emplace("chromium." + key, std::move(converted));
+  }
+  auto serialized = base::WriteJson(*root);
+  if (!serialized) {
+    return "Unable to serialize fingerprint configuration";
+  }
+  next->serialized = std::move(*serialized);
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  if (state.frozen) {
+    return "Fingerprint configuration is frozen; configure before WebView "
+           "startup";
+  }
+  state.snapshot = std::move(next);
+  return {};
+}
+
+void FreezeWebViewFingerprint() {
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  state.frozen = true;
+}
+
+std::shared_ptr<const WebViewFingerprintConfig> GetWebViewFingerprintConfig() {
+  auto& state = State();
+  base::AutoLock lock(state.lock);
+  return state.snapshot;
+}
+
+}  // namespace blink

+package org.chromium.android_webview;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+/** Native, process-scoped fingerprint configuration supplied by the host app. */
+@JNINamespace("android_webview")
+public final class AwFingerprintConfig {
+    private AwFingerprintConfig() {}
+
+    public static String configure(String json) {
+        return AwFingerprintConfigJni.get().configure(json);
+    }
+
+    @NativeMethods
+    interface Natives {
+        @JniType("std::string")
+        String configure(@JniType("std::string") String json);
+    }
+}

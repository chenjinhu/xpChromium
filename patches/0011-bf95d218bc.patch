+package com.android.webview.chromium;
+
+import org.chromium.android_webview.AwFingerprintConfig;
+import org.chromium.build.annotations.UsedByReflection;
+
+/** Host API, available through WebView.getWebViewClassLoader() before startup. */
+@UsedByReflection("xpChromium host application")
+public final class FingerprintConfig {
+    private FingerprintConfig() {}
+
+    /** Returns an empty string on success, or a validation/startup error. */
+    @UsedByReflection("xpChromium host application")
+    public static String configure(String json) {
+        if (json == null) return "Fingerprint JSON must not be null";
+        return AwFingerprintConfig.configure(json);
+    }
+}

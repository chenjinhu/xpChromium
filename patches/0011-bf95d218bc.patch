diff --git a/webview_custom/tests/fingerprint_config_test.cc b/webview_custom/tests/fingerprint_config_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..bb37b4d6172bf190d540d300566257354b1b99f3
--- /dev/null
+++ b/webview_custom/tests/fingerprint_config_test.cc
@@ -0,0 +1,107 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/webview/fingerprint_config.h"
+
+#include <atomic>
+#include <iostream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+
+int main(int argc, char** argv) {
+  using blink::ConfigureWebViewFingerprint;
+  using blink::GetWebViewFingerprintConfig;
+  base::CommandLine::Init(argc, argv);
+  const auto arguments = base::CommandLine::ForCurrentProcess()->GetArgs();
+  if (arguments.size() == 1) {
+    // A fresh process validates the exact serialized renderer payload.
+    CHECK(ConfigureWebViewFingerprint(arguments.front()).empty());
+    blink::FreezeWebViewFingerprint();
+    CHECK(GetWebViewFingerprintConfig()->enabled);
+    CHECK(GetWebViewFingerprintConfig()->Find(
+              "chromium.navigator.hardwareConcurrency") == "8");
+    std::cout << "PASS renderer snapshot import\n";
+    return 0;
+  }
+  CHECK(!GetWebViewFingerprintConfig()->enabled);
+  const std::string valid = R"({"version":1,"enabled":true,"settings":{
+    "navigator.useragent":"Mozilla/5.0 configured WebView",
+    "navigator.hardwareConcurrency":8,"navigator.deviceMemory":8,
+    "config.x_requested_with":"","canvas.fillRectNoise":false,
+    "network.proxy":"socks5://[2001:db8::1]:1080",
+    "navigator.userAgentMeta.brands":[{"brand":"Chromium","version":"158"}]
+  }})";
+  CHECK(ConfigureWebViewFingerprint(valid).empty());
+  auto first = GetWebViewFingerprintConfig();
+  CHECK(first->enabled);
+  CHECK(first->Find("chromium.config.x_requested_with") == "");
+  CHECK(first->Find("chromium.canvas.fillRectNoise") == "0");
+  CHECK(first->Find("chromium.navigator.userAgentMeta.brands") ==
+        "Chromium,158");
+  CHECK(base::JSONReader::ReadDict(first->serialized, base::JSON_PARSE_RFC));
+
+  const std::vector<std::string> invalid = {
+      "{",
+      "[]",
+      R"({"version":2,"enabled":true,"settings":{}})",
+      R"({"version":1,"enabled":"true","settings":{}})",
+      R"({"version":1,"enabled":true,"settings":{},"extra":1})",
+      R"({"version":1,"enabled":true,"settings":{"unknown":1}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.hardwareConcurrency":"8"}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.hardwareConcurrency":0}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.hardwareConcurrency":8.5}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.useragent":"x\r\ny"}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.userAgentMeta.model":"设备"}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.userAgentMeta.brands":"A,1"}})",
+      R"({"version":1,"enabled":true,"settings":{"network.proxy":"direct://"}})",
+      R"({"version":1,"enabled":true,"settings":{"network.proxy":"http://u:p@proxy:80"}})",
+      R"({"version":1,"enabled":true,"settings":{"network.proxy":"http://proxy:80/"}})",
+      R"({"version":1,"enabled":true,"settings":{"webrtc.private_ip":"01.2.3.4"}})",
+      R"({"version":1,"enabled":true,"settings":{"navigator.connection.type":"bad"}})",
+      std::string(32769, ' '),
+  };
+  for (const auto& json : invalid) {
+    CHECK(!ConfigureWebViewFingerprint(json).empty());
+    CHECK(GetWebViewFingerprintConfig() == first);
+  }
+  std::atomic<bool> stop = false;
+  std::vector<std::thread> readers;
+  for (int i = 0; i < 4; ++i) {
+    readers.emplace_back([&] {
+      while (!stop.load()) {
+        auto snapshot = GetWebViewFingerprintConfig();
+        CHECK(snapshot->enabled);
+        CHECK(snapshot->Find("chromium.navigator.hardwareConcurrency") == "8");
+      }
+    });
+  }
+  for (int i = 0; i < 100; ++i) {
+    CHECK(ConfigureWebViewFingerprint(valid).empty());
+  }
+  stop.store(true);
+  for (auto& reader : readers) {
+    reader.join();
+  }
+  CHECK(first->Find("chromium.navigator.hardwareConcurrency") == "8");
+  CHECK(ConfigureWebViewFingerprint(
+            R"({"version":1,"enabled":false,"settings":{}})")
+            .empty());
+  CHECK(!GetWebViewFingerprintConfig()->enabled);
+  CHECK(!GetWebViewFingerprintConfig()->Find(
+      "chromium.navigator.hardwareConcurrency"));
+  CHECK(first->enabled);  // Previously captured snapshots cannot be mutated.
+  CHECK(ConfigureWebViewFingerprint(valid).empty());
+  blink::FreezeWebViewFingerprint();
+  auto frozen = GetWebViewFingerprintConfig();
+  CHECK(!ConfigureWebViewFingerprint(valid).empty());
+  CHECK(GetWebViewFingerprintConfig() == frozen);
+  std::cout << "PASS schema, types, brands, proxy, atomic failure, "
+               "replacement, concurrent snapshots and freeze\n";
+  std::cout << frozen->serialized << '\n';
+}

@@ -0,0 +1,213 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <iostream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "android_webview/browser/aw_ip_geolocation_context.h"
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_executor.h"
+#include "mojo/core/embedder/embedder.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "services/device/public/mojom/geolocation.mojom.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "url/origin.h"
+
+namespace {
+constexpr char kEndpoint[] = "https://example.test/ip";
+using android_webview::AwIpGeolocationContext;
+
+// Exercise the production network/queue logic with real Chromium URL loaders
+// and Mojo. Only the downstream device context is replaced: Android GPS and
+// permission UI are covered by the APK build and require device testing.
+class DeviceContext final : public device::mojom::GeolocationContext {
+ public:
+  void BindGeolocation(
+      mojo::PendingReceiver<device::mojom::Geolocation> receiver,
+      const url::Origin& origin,
+      device::mojom::GeolocationClientId client_id,
+      bool precise) override {
+    CHECK(result);  // Override must arrive before every native binding.
+    receivers.push_back(std::move(receiver));
+    last_precise = precise;
+  }
+  void OnPermissionUpdated(
+      const url::Origin& origin,
+      device::mojom::GeolocationPermissionLevel permission_level) override {}
+  void SetOverride(device::mojom::GeopositionResultPtr value) override {
+    result = std::move(value);
+  }
+  void ClearOverride() override { ++clears; }
+
+  mojo::Receiver<device::mojom::GeolocationContext> context_receiver{this};
+  device::mojom::GeopositionResultPtr result;
+  std::vector<mojo::PendingReceiver<device::mojom::Geolocation>> receivers;
+  bool last_precise = false;
+  int clears = 0;
+};
+
+struct Fixture {
+  Fixture() {
+    mojo::Remote<device::mojom::GeolocationContext> remote;
+    device.context_receiver.Bind(remote.BindNewPipeAndPassReceiver());
+    context = std::make_unique<AwIpGeolocationContext>(
+        factory.GetSafeWeakWrapper(), std::move(remote), GURL(kEndpoint),
+        50000);
+  }
+
+  mojo::Remote<device::mojom::Geolocation> Bind() {
+    mojo::Remote<device::mojom::Geolocation> remote;
+    context->BindGeolocation(
+        remote.BindNewPipeAndPassReceiver(), origin,
+        device::mojom::GeolocationClientId::kGeolocationServiceImpl, true);
+    return remote;
+  }
+
+  void Respond(std::string_view json) {
+    CHECK(factory.SimulateResponseForPendingRequest(kEndpoint, json));
+    base::RunLoop().RunUntilIdle();
+  }
+
+  network::TestURLLoaderFactory factory;
+  DeviceContext device;
+  std::unique_ptr<AwIpGeolocationContext> context;
+  url::Origin origin = url::Origin::Create(GURL("https://page.test"));
+};
+}  // namespace
+
+int main() {
+  base::SingleThreadTaskExecutor executor;
+  mojo::core::Init();
+  {
+    Fixture f;
+    auto a = f.Bind();
+    auto b = f.Bind();
+    CHECK_EQ(f.factory.NumPending(), 1);
+    CHECK(f.device.receivers.empty());
+    const auto& request = f.factory.GetPendingRequest(0)->request;
+    CHECK_EQ(request.credentials_mode, network::mojom::CredentialsMode::kOmit);
+    CHECK_EQ(request.redirect_mode, network::mojom::RedirectMode::kError);
+    CHECK(request.load_flags & net::LOAD_DISABLE_CACHE);
+    CHECK(request.do_not_prompt_for_login);
+    f.Respond(R"({"success":true,"latitude":35.5,"longitude":139.5})");
+    CHECK(f.device.result->is_position());
+    CHECK_EQ(f.device.result->get_position()->latitude, 35.5);
+    CHECK_EQ(f.device.result->get_position()->longitude, 139.5);
+    CHECK_EQ(f.device.result->get_position()->accuracy, 50000);
+    CHECK(!f.device.result->get_position()->timestamp.is_null());
+    CHECK(!f.device.result->get_position()->is_precise);
+    CHECK_EQ(f.device.receivers.size(), 2u);
+    auto c = f.Bind();
+    base::RunLoop().RunUntilIdle();
+    CHECK_EQ(f.device.receivers.size(), 3u);
+    CHECK_EQ(f.factory.NumPending(), 0);
+  }
+  {
+    Fixture f;
+    auto a = f.Bind();
+    f.Respond(R"({"latitude":"-90","longitude":"180"})");
+    CHECK(f.device.result->is_position());
+  }
+  const std::vector<std::string> invalid = {
+      "not JSON",
+      "[]",
+      "{}",
+      R"({"latitude":91,"longitude":0})",
+      R"({"latitude":0,"longitude":-181})",
+      R"({"latitude":false,"longitude":0})",
+      R"({"latitude":"NaN","longitude":0})",
+      R"({"latitude":"1oops","longitude":0})",
+      R"({"success":false,"latitude":1,"longitude":2})",
+      R"({"success":"false","latitude":1,"longitude":2})",
+      std::string(65537, 'x')};
+  for (const auto& body : invalid) {
+    Fixture f;
+    auto a = f.Bind();
+    f.Respond(body);
+    CHECK(f.device.result->is_error());
+    CHECK_EQ(f.device.result->get_error()->error_code,
+             device::mojom::GeopositionErrorCode::kPositionUnavailable);
+    CHECK_EQ(f.device.receivers.size(), 1u);
+    auto b = f.Bind();
+    base::RunLoop().RunUntilIdle();
+    CHECK_EQ(f.factory.NumPending(), 0);
+    CHECK_EQ(f.device.receivers.size(), 2u);
+    CHECK_EQ(f.device.clears, 0);
+  }
+  {
+    Fixture f;
+    auto a = f.Bind();
+    CHECK(f.factory.IsPending(kEndpoint));
+    CHECK(f.factory.SimulateResponseForPendingRequest(
+        GURL(kEndpoint), network::URLLoaderCompletionStatus(net::ERR_TIMED_OUT),
+        network::mojom::URLResponseHead::New(), ""));
+    base::RunLoop().RunUntilIdle();
+    CHECK(f.device.result->is_error());
+    CHECK_EQ(f.device.clears, 0);
+  }
+  {
+    Fixture f;
+    auto a = f.Bind();
+    f.context->OnPermissionUpdated(
+        f.origin, device::mojom::GeolocationPermissionLevel::kDenied);
+    f.Respond(R"({"latitude":1,"longitude":2})");
+    CHECK(f.device.receivers.empty());
+  }
+  {
+    Fixture f;
+    auto a = f.Bind();
+    f.context->OnPermissionUpdated(
+        f.origin, device::mojom::GeolocationPermissionLevel::kApproximate);
+    f.Respond(R"({"latitude":1,"longitude":2})");
+    CHECK(!f.device.last_precise);
+    f.context->ClearOverride();
+    f.Respond(R"({"latitude":3,"longitude":4})");
+    CHECK_EQ(f.device.result->get_position()->latitude, 3);
+    CHECK_EQ(f.device.clears, 0);
+  }
+  {
+    Fixture f;
+    auto a = f.Bind();
+    CHECK(f.factory.SimulateResponseForPendingRequest(
+        kEndpoint, R"({"latitude":1,"longitude":2})",
+        net::HTTP_SERVICE_UNAVAILABLE));
+    base::RunLoop().RunUntilIdle();
+    CHECK(f.device.result->is_error());
+  }
+  {
+    Fixture f;
+    f.context->SetOverride(device::mojom::GeopositionResult::NewError(
+        device::mojom::GeopositionError::New(
+            device::mojom::GeopositionErrorCode::kPositionUnavailable,
+            "Debugger test", "")));
+    auto a = f.Bind();
+    base::RunLoop().RunUntilIdle();
+    CHECK(f.device.result->is_error());
+    CHECK(!f.factory.IsPending(kEndpoint));
+    f.context->ClearOverride();
+    f.Respond(R"({"latitude":1,"longitude":2})");
+    CHECK(f.device.result->is_position());
+    CHECK_EQ(f.device.clears, 0);
+  }
+  {
+    Fixture f;
+    auto a = f.Bind();
+    CHECK(f.factory.IsPending(kEndpoint));
+    f.context.reset();
+    base::RunLoop().RunUntilIdle();
+    CHECK(f.device.receivers.empty());
+  }
+  std::cout << "PASS IP lookup, queue/order, cache, validation, size, timeout, "
+               "permission updates, IP restore and destruction\n";
+}

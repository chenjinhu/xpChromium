diff --git a/android_webview/browser/aw_ip_geolocation_context.cc b/android_webview/browser/aw_ip_geolocation_context.cc
new file mode 100644
index 0000000000000000000000000000000000000000..acda3dcfc1d6019b8a48619489b9ce98cb700e8a
--- /dev/null
+++ b/android_webview/browser/aw_ip_geolocation_context.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "android_webview/browser/aw_ip_geolocation_context.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+
+namespace android_webview {
+namespace {
+constexpr size_t kMaxResponseBytes = 65536;
+
+std::optional<double> Coordinate(const base::DictValue& dict,
+                                 std::string_view key,
+                                 double limit) {
+  const auto* value = dict.Find(key);
+  double number;
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_int() || value->is_double()) {
+    number = value->GetDouble();
+  } else if (!value->is_string() ||
+             !base::StringToDouble(value->GetString(), &number)) {
+    return std::nullopt;
+  }
+  if (!std::isfinite(number) || std::abs(number) > limit) {
+    return std::nullopt;
+  }
+  return number;
+}
+
+device::mojom::GeopositionResultPtr Unavailable() {
+  return device::mojom::GeopositionResult::NewError(
+      device::mojom::GeopositionError::New(
+          device::mojom::GeopositionErrorCode::kPositionUnavailable,
+          "IP-based location is unavailable", ""));
+}
+}  // namespace
+
+AwIpGeolocationContext::AwIpGeolocationContext(
+    scoped_refptr<network::SharedURLLoaderFactory> factory,
+    mojo::Remote<device::mojom::GeolocationContext> device_context,
+    GURL endpoint,
+    double accuracy)
+    : factory_(std::move(factory)),
+      device_context_(std::move(device_context)),
+      endpoint_(std::move(endpoint)),
+      accuracy_(accuracy) {
+  CHECK(factory_);
+  CHECK(endpoint_.is_valid() && endpoint_.SchemeIs("https"));
+  CHECK(std::isfinite(accuracy_) && accuracy_ >= 1000 && accuracy_ <= 1e7);
+}
+
+AwIpGeolocationContext::~AwIpGeolocationContext() = default;
+
+void AwIpGeolocationContext::BindGeolocation(
+    mojo::PendingReceiver<device::mojom::Geolocation> receiver,
+    const url::Origin& requesting_origin,
+    device::mojom::GeolocationClientId client_id,
+    bool has_precise_permission) {
+  // Keep a successful location stable for this WebContents. Retry a failed
+  // lookup only on a new request, with a cooldown to prevent request storms.
+  if (!loader_ && result_ &&
+      (explicit_override_ || result_->is_position() ||
+       base::TimeTicks::Now() - last_attempt_ < base::Seconds(30))) {
+    device_context_->BindGeolocation(std::move(receiver), requesting_origin,
+                                     client_id, has_precise_permission);
+    return;
+  }
+  pending_bindings_.push_back({std::move(receiver), requesting_origin,
+                               client_id, has_precise_permission});
+  if (!loader_) {
+    StartLookup();
+  }
+}
+
+void AwIpGeolocationContext::OnPermissionUpdated(
+    const url::Origin& origin,
+    device::mojom::GeolocationPermissionLevel permission_level) {
+  if (permission_level == device::mojom::GeolocationPermissionLevel::kDenied) {
+    std::erase_if(pending_bindings_, [&](const PendingBinding& item) {
+      return item.origin == origin;
+    });
+  } else {
+    for (auto& item : pending_bindings_) {
+      if (item.origin == origin) {
+        item.precise = permission_level ==
+                       device::mojom::GeolocationPermissionLevel::kPrecise;
+      }
+    }
+  }
+  device_context_->OnPermissionUpdated(origin, permission_level);
+}
+
+void AwIpGeolocationContext::SetOverride(
+    device::mojom::GeopositionResultPtr result) {
+  explicit_override_ = true;
+  // Preserve debugger overrides; clearing them restores IP mode, never GPS.
+  weak_factory_.InvalidateWeakPtrs();
+  loader_.reset();
+  ApplyResult(std::move(result));
+}
+
+void AwIpGeolocationContext::ClearOverride() {
+  explicit_override_ = false;
+  weak_factory_.InvalidateWeakPtrs();
+  loader_.reset();
+  result_.reset();
+  StartLookup();
+}
+
+void AwIpGeolocationContext::StartLookup() {
+  last_attempt_ = base::TimeTicks::Now();
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = endpoint_;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->do_not_prompt_for_login = true;
+  constexpr auto annotation =
+      net::DefineNetworkTrafficAnnotation("webview_ip_geolocation", R"(
+        semantics {
+          sender: "WebView IP geolocation"
+          description:
+            "When explicitly configured, obtains approximate coordinates for "
+            "the WebView's network exit IP using that WebView's network context."
+          trigger: "A permitted page requests geolocation in configured IP mode."
+          data: "An HTTPS GET. No cookies, device GPS or Wi-Fi scan data."
+          destination: OTHER
+          destination_other: "The configured IP lookup endpoint; default ipwho.is."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Disabled by default; enabled by geolocation.mode=ip in the startup JSON."
+          policy_exception_justification: "A custom WebView build startup setting."
+        })");
+  loader_ = network::SimpleURLLoader::Create(std::move(request), annotation);
+  loader_->SetTimeoutDuration(base::Seconds(10));
+  loader_->DownloadToString(
+      factory_.get(),
+      base::BindOnce(&AwIpGeolocationContext::OnLookupComplete,
+                     weak_factory_.GetWeakPtr()),
+      kMaxResponseBytes);
+}
+
+void AwIpGeolocationContext::OnLookupComplete(std::optional<std::string> body) {
+  auto result = Unavailable();
+  if (body && loader_->NetError() == net::OK) {
+    auto dict = base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+    if (dict &&
+        (!dict->Find("success") || dict->FindBool("success").value_or(false))) {
+      const auto latitude = Coordinate(*dict, "latitude", 90);
+      const auto longitude = Coordinate(*dict, "longitude", 180);
+      if (latitude && longitude) {
+        auto position = device::mojom::Geoposition::New();
+        position->latitude = *latitude;
+        position->longitude = *longitude;
+        position->accuracy = accuracy_;
+        position->timestamp = base::Time::Now();
+        position->is_precise = false;
+        result =
+            device::mojom::GeopositionResult::NewPosition(std::move(position));
+      }
+    }
+  }
+  // Never log endpoint URLs, API keys, IP addresses or coordinates.
+  if (result->is_error()) {
+    LOG(WARNING)
+        << "IP geolocation lookup failed; system location remains disabled";
+  } else {
+    LOG(INFO) << "IP geolocation is ready";
+  }
+  loader_.reset();
+  ApplyResult(std::move(result));
+}
+
+void AwIpGeolocationContext::ApplyResult(
+    device::mojom::GeopositionResultPtr result) {
+  result_ = std::move(result);
+  // This message is queued before any bindings, including on lookup failure.
+  device_context_->SetOverride(result_->Clone());
+  for (auto& item : pending_bindings_) {
+    device_context_->BindGeolocation(std::move(item.receiver), item.origin,
+                                     item.client_id, item.precise);
+  }
+  pending_bindings_.clear();
+}
+
+}  // namespace android_webview

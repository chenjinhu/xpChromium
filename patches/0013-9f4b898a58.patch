@@ -29,7 +29,8 @@ enum class Kind {
   kNumber,
   kBrands,
   kProxy,
-  kIPv4
+  kIPv4,
+  kHttpsUrl
 };
 struct Field {
   std::string_view key;
@@ -41,6 +42,9 @@ constexpr Field kFields[] = {
     {"navigator.useragent", Kind::kHeader},
     {"config.x_requested_with", Kind::kHeader},
     {"network.proxy", Kind::kProxy},
+    {"geolocation.mode", Kind::kAscii},
+    {"geolocation.endpoint", Kind::kHttpsUrl},
+    {"geolocation.accuracy", Kind::kNumber, 1000, 1e7},
     {"navigator.hardwareConcurrency", Kind::kInt, 1, 1024},
     {"navigator.deviceMemory", Kind::kNumber, 0.125, 1024},
     {"navigator.maxTouchPoints", Kind::kInt, 0, 100},
@@ -198,6 +202,19 @@ bool Convert(const Field& field,
   if (field.key == "navigator.useragent" && output.empty()) {
     return false;
   }
+  if (field.key == "geolocation.mode" && output != "native" && output != "ip") {
+    return false;
+  }
+  if (field.kind == Kind::kHttpsUrl) {
+    const GURL url(output);
+    if (!url.is_valid() || !url.SchemeIs("https") || url.host().empty() ||
+        url.has_username() || url.has_password() || url.has_ref() ||
+        !std::all_of(output.begin(), output.end(),
+                     [](unsigned char c) { return c > 32 && c < 127; }) ||
+        (url.has_port() && url.IntPort() <= 0)) {
+      return false;
+    }
+  }
   if (field.kind == Kind::kIPv4 && !ValidIPv4(output)) {
     return false;
   }

+device::mojom::GeolocationContext*
+AwContentBrowserClient::GetGeolocationContextOverride(
+    content::WebContents* web_contents) {
+  const blink::WebViewPropertyOverrides config;
+  if (!config.enabled() ||
+      config.GetString("chromium.geolocation.mode") != "ip") {
+    return nullptr;
+  }
+  static const char kContextKey = 0;
+  auto* context = static_cast<AwIpGeolocationContext*>(
+      web_contents->GetUserData(&kContextKey));
+  if (!context) {
+    mojo::Remote<device::mojom::GeolocationContext> device_context;
+    content::GetDeviceService().BindGeolocationContext(
+        device_context.BindNewPipeAndPassReceiver());
+    auto owned = std::make_unique<AwIpGeolocationContext>(
+        web_contents->GetPrimaryMainFrame()
+            ->GetStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess(),
+        std::move(device_context),
+        GURL(config.GetString("chromium.geolocation.endpoint")
+                 .value_or("https://ipwho.is/")),
+        config.GetDouble("chromium.geolocation.accuracy", 1000, 1e7)
+            .value_or(50000));
+    context = owned.get();
+    web_contents->SetUserData(&kContextKey, std::move(owned));
+  }
+  return context;
+}
+
 AwContentBrowserClient::~AwContentBrowserClient() = default;
 
 void AwContentBrowserClient::OnNetworkServiceCreated(

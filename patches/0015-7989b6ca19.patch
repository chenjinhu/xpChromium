+  ApplyIdentityRequestHeaders(headers, 0, std::nullopt);
+  EXPECT_EQ(headers.GetHeader("DNT"), "0");
+  EXPECT_EQ(headers.GetHeader("Accept-Language"), "zh-CN,zh;q=0.9");

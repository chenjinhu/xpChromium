+void ApplyIdentityRequestHeaders(
+    HttpRequestHeaders& headers,
+    int dnt,
+    const std::optional<std::string>& accept_language) {
+  if (dnt == 0 || dnt == 1) {
+    headers.SetHeader("DNT", dnt ? "1" : "0");

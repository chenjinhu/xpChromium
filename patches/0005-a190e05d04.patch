index 0000000000000000000000000000000000000000..01f8b7b70806aa0280bd380a4447c42eca40aab0
--- /dev/null
+++ b/base/android/webview_property_overrides.h
@@ -0,0 +1,300 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_ANDROID_WEBVIEW_PROPERTY_OVERRIDES_H_
+#define BASE_ANDROID_WEBVIEW_PROPERTY_OVERRIDES_H_
+
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstdlib>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include <sys/system_properties.h>
+#endif
+
+namespace base::android::webview {
+
+// Do not cache values: a controller may change a property while WebView runs.
+// An absent property is distinct from an explicitly empty X-Requested-With.
+inline std::optional<std::string> RawProperty(const char* name) {
+#if BUILDFLAG(IS_ANDROID)
+  const prop_info* info = __system_property_find(name);
+  if (info) {
+    std::string value;
+    __system_property_read_callback(
+        info,
+        [](void* cookie, const char*, const char* text, uint32_t) {
+          *static_cast<std::string*>(cookie) = text;
+        },
+        &value);
+    return value;
+  }
+#endif
+  return std::nullopt;
+}
+
+inline bool Enabled() {
+  return RawProperty("chromium.enable") == "1";
+}
+
+inline std::optional<std::string> GetString(const char* name) {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  auto value = RawProperty(name);
+  if (!value || value->empty() || *value == "-") {
+    return std::nullopt;
+  }
+  return value;
+}
+
+inline std::optional<int> GetInt(const char* name, int min, int max) {
+  auto text = GetString(name);
+  if (!text) {
+    return std::nullopt;
+  }
+  int value;
+  auto result =
+      std::from_chars(text->data(), text->data() + text->size(), value);
+  if (result.ec != std::errc() || result.ptr != text->data() + text->size() ||
+      value < min || value > max) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+inline std::optional<double> GetDouble(const char* name,
+                                       double min,
+                                       double max) {
+  auto text = GetString(name);
+  if (!text || text->find_first_of(" \t\r\n") != std::string::npos) {
+    return std::nullopt;
+  }
+  char* end = nullptr;
+  double value = std::strtod(text->c_str(), &end);
+  if (end != text->c_str() + text->size() || !std::isfinite(value) ||
+      value < min || value > max) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+inline std::optional<bool> GetBool(const char* name) {
+  auto text = GetString(name);
+  if (text == "1" || text == "true") {
+    return true;
+  }
+  if (text == "0" || text == "false") {
+    return false;
+  }
+  return std::nullopt;
+}
+
+inline bool ValidHeaderValue(std::string_view value) {
+  return std::all_of(value.begin(), value.end(), [](unsigned char c) {
+    return c == '\t' || (c >= 32 && c != 127);
+  });
+}
+
+inline std::optional<std::string> UserAgent() {
+  auto first = GetString("chromium.navigator.useragent");
+  if (!first) {
+    return std::nullopt;
+  }
+  for (const char* key :
+       {"chromium.navigator.useragent2", "chromium.navigator.useragent3"}) {
+    auto next = RawProperty(key);
+    if (next && *next != "-") {
+      first->append(*next);
+    }
+  }
+  return ValidHeaderValue(*first) ? first : std::nullopt;
+}
+
+// nullopt: retain Chromium policy; empty: remove; otherwise: replace.
+inline std::optional<std::string> RequestedWith() {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  auto value = RawProperty("chromium.config.x_requested_with");
+  if (!value || *value == "-" || !ValidHeaderValue(*value)) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+// Works with HttpRequestHeadersUpdateParams; keep HTTP dependencies out of
+// base.
+template <typename HeaderUpdates>
+inline void ApplyRequestHeaderOverrides(HeaderUpdates& updates) {
+  if (auto value = RequestedWith()) {
+    updates.RemoveHeader("X-Requested-With");
+    if (!value->empty()) {
+      updates.SetCorsExemptHeader("X-Requested-With", *value);
+    }
+  }
+  if (auto value = UserAgent()) {
+    updates.RemoveHeader("User-Agent");
+    updates.SetHeader("User-Agent", *value);
+  }
+}
+
+inline std::vector<std::pair<std::string, std::string>> Brands(
+    const char* name) {
+  auto text = GetString(name);
+  std::vector<std::pair<std::string, std::string>> result;
+  if (!text) {
+    return result;
+  }
+  std::string_view remaining(*text);
+  while (!remaining.empty()) {
+    size_t separator = remaining.find('&');
+    auto part = remaining.substr(0, separator);
+    size_t comma = part.find(',');
+    if (comma == std::string_view::npos || comma == 0 ||
+        part.find(',', comma + 1) != std::string_view::npos ||
+        !ValidHeaderValue(part)) {
+      return {};
+    }
+    result.emplace_back(part.substr(0, comma), part.substr(comma + 1));
+    if (separator == std::string_view::npos) {
+      break;
+    }
+    remaining.remove_prefix(separator + 1);
+    if (remaining.empty()) {
+      return {};
+    }
+  }
+  return result;
+}
+
+inline bool IsIPv4(std::string_view value) {
+  for (int i = 0; i < 4; ++i) {
+    size_t dot = value.find('.');
+    auto part = value.substr(0, dot);
+    unsigned number;
+    auto r = std::from_chars(part.data(), part.data() + part.size(), number);
+    if (part.empty() || r.ec != std::errc() ||
+        r.ptr != part.data() + part.size() || number > 255) {
+      return false;
+    }
+    if (i == 3) {
+      return dot == std::string_view::npos;
+    }
+    if (dot == std::string_view::npos) {
+      return false;
+    }
+    value.remove_prefix(dot + 1);
+  }
+  return false;
+}
+
+inline std::optional<std::string> IceAddress(std::string_view type,
+                                             bool related = false) {
+  const char* key = type == "host" || (type == "srflx" && related)
+                        ? "chromium.webrtc.private_ip"
+                        : "chromium.webrtc.public_ip";
+  if (type != "host" && type != "srflx" && type != "relay") {
+    return std::nullopt;
+  }
+  auto ip = GetString(key);
+  return ip && IsIPv4(*ip) ? ip : std::nullopt;
+}
+
+inline std::string IceCandidate(std::string_view input) {
+  std::vector<std::string> fields;
+  std::string_view rest = input;
+  while (!rest.empty()) {
+    auto pos = rest.find(' ');
+    fields.emplace_back(rest.substr(0, pos));
+    if (pos == std::string_view::npos) {
+      break;
+    }
+    rest.remove_prefix(pos + 1);
+  }
+  if (fields.size() < 8 || fields[6] != "typ") {
+    return std::string(input);
+  }
+  auto address = IceAddress(fields[7]);
+  if (address && IsIPv4(fields[4])) {
+    fields[4] = *address;
+  }
+  auto related = IceAddress(fields[7], true);
+  for (size_t i = 8; i + 1 < fields.size(); ++i) {
+    if (fields[i] == "raddr" && related && IsIPv4(fields[i + 1])) {
+      fields[i + 1] = *related;
+    }
+  }
+  std::string output;
+  for (const auto& field : fields) {
+    if (!output.empty()) {
+      output += ' ';
+    }
+    output += field;
+  }
+  return output;
+}
+
+// Deliberately separate from the master switch: stripping candidates can
+// prevent a copied SDP from establishing a real peer connection.
+inline std::string RedactSdp(std::string_view input) {
+  if (GetBool("chromium.webrtc.sdp_redact") != true) {
+    return std::string(input);
+  }
+  std::string output;
+  while (!input.empty()) {
+    auto end = input.find('\n');
+    auto line = input.substr(0, end);
+    bool cr = !line.empty() && line.back() == '\r';
+    if (cr) {
+      line.remove_suffix(1);
+    }
+    if (!line.starts_with("a=candidate:")) {
+      if (line.starts_with("c=IN IP4 ") && IsIPv4(line.substr(9))) {
+        output += "c=IN IP4 0.0.0.0";
+      } else {
+        output += line;
+      }
+      if (cr) {
+        output += '\r';
+      }
+      if (end != std::string_view::npos) {
+        output += '\n';
+      }
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    input.remove_prefix(end + 1);
+  }
+  return output;
+}
+
+template <typename Samples>
+inline bool PerturbAudio(Samples samples, double seed) {
+  if (!std::isfinite(seed) || seed == 0) {
+    return false;
+  }
+  float delta = static_cast<float>(std::clamp(seed * 0.123, -0.00001, 0.00001));
+  bool changed = false;
+  for (float& sample : samples) {
+    if (sample != 0 && std::isfinite(sample)) {
+      sample += delta;
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+}  // namespace base::android::webview
+
+#endif  // BASE_ANDROID_WEBVIEW_PROPERTY_OVERRIDES_H_

+#!/usr/bin/env python3
+"""Compile and exercise the production property helper using fake Android APIs."""
+from pathlib import Path
+import subprocess, tempfile, shutil
+
+root = Path(__file__).parent
+with tempfile.TemporaryDirectory(prefix='webview-properties-') as work:
+    p = Path(work)
+    (p/'build').mkdir()
+    (p/'sys').mkdir()
+    (p/'build/build_config.h').write_text('#define BUILDFLAG(x) 1\n')
+    (p/'sys/system_properties.h').write_text('''#include <cstdint>
+#include <map>
+#include <string>
+struct prop_info { std::string name; std::string value; };
+inline std::map<std::string, prop_info> props;
+inline const prop_info* __system_property_find(const char* name) {
+  auto it = props.find(name); return it == props.end() ? nullptr : &it->second;
+}
+inline void __system_property_read_callback(const prop_info* p,
+ void (*callback)(void*,const char*,const char*,uint32_t), void* cookie) {
+ callback(cookie,p->name.c_str(),p->value.c_str(),0);
+}
+''')
+    shutil.copyfile(root.parent/'base/android/webview_property_overrides.h', p/'production.h')
+    (p/'test.cc').write_text(r'''
+#include "production.h"
+#include <array>
+#include <cassert>
+#include <span>
+#include <limits>
+using namespace base::android::webview;
+void set(const char* name, const char* value) { props[name] = {name,value}; }

+void ApplyUserAgentPropertyOverrides(UserAgentMetadata& metadata,
+                                     bool only_low_entropy) {
+  auto brands =
+      base::android::webview::Brands("chromium.navigator.userAgentMeta.brands");
+  if (!brands.empty()) {
+    metadata.brand_version_list.clear();
+    for (const auto& [brand, version] : brands) {
+      metadata.brand_version_list.emplace_back(brand, version);
+    }
+  }
+  if (auto value = base::android::webview::GetBool(
+          "chromium.navigator.userAgentMeta.mobile")) {
+    metadata.mobile = *value;
+  }
+  if (auto value = base::android::webview::GetString(
+          "chromium.navigator.userAgentMeta.platform")) {
+    metadata.platform = *value;
+  }
+  if (only_low_entropy) {
+    return;
+  }
+  if (auto value = base::android::webview::GetString(
+          "chromium.navigator.userAgentMeta.platformVersion")) {
+    metadata.platform_version = *value;
+  }
+  if (auto value = base::android::webview::GetString(
+          "chromium.navigator.userAgentMeta.architecture")) {
+    metadata.architecture = *value;
+  }
+  if (auto value = base::android::webview::GetString(
+          "chromium.navigator.userAgentMeta.model")) {
+    metadata.model = *value;
+  }
+  if (auto value = base::android::webview::GetString(
+          "chromium.navigator.userAgentMeta.fullVersion")) {
+    metadata.full_version = *value;
+  }
+  if (auto value = base::android::webview::GetString(
+          "chromium.navigator.userAgentMeta.bitness")) {
+    metadata.bitness = *value;
+  }
+  if (auto value = base::android::webview::GetBool(
+          "chromium.navigator.userAgentMeta.wow64")) {
+    metadata.wow64 = *value;
+  }
+  auto full = base::android::webview::Brands(
+      "chromium.navigator.userAgentMeta.fullVersionList");
+  if (!full.empty()) {
+    metadata.brand_full_version_list.clear();
+    for (const auto& [brand, version] : full) {
+      metadata.brand_full_version_list.emplace_back(brand, version);
+    }
+  }
+}
+
 }  // namespace blink

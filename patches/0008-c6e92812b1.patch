@@ -215,6 +216,9 @@ inline std::optional<std::string> IceAddress(std::string_view type,
 }
 
 inline std::string IceCandidate(std::string_view input) {
+  if (!Enabled()) {
+    return std::string(input);
+  }
   std::vector<std::string> fields;
   std::string_view rest = input;
   while (!rest.empty()) {
@@ -229,15 +233,21 @@ inline std::string IceCandidate(std::string_view input) {
     return std::string(input);
   }
   auto address = IceAddress(fields[7]);
+  bool changed = false;
   if (address && IsIPv4(fields[4])) {
+    changed |= fields[4] != *address;
     fields[4] = *address;
   }
   auto related = IceAddress(fields[7], true);
   for (size_t i = 8; i + 1 < fields.size(); ++i) {
     if (fields[i] == "raddr" && related && IsIPv4(fields[i + 1])) {
+      changed |= fields[i + 1] != *related;
       fields[i + 1] = *related;
     }
   }
+  if (!changed) {
+    return std::string(input);
+  }
   std::string output;
   for (const auto& field : fields) {
     if (!output.empty()) {

@@ -87,6 +87,9 @@ void RTCSessionDescription::setType(std::optional<V8RTCSdpType> type) {
 }
 
 String RTCSessionDescription::sdp() const {
+  if (base::android::webview::GetBool("chromium.webrtc.sdp_redact") != true) {
+    return platform_session_description_->Sdp();
+  }
   return String::FromUtf8(base::android::webview::RedactSdp(
       platform_session_description_->Sdp().Utf8()));
 }

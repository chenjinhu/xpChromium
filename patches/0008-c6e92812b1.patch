diff --git a/third_party/blink/renderer/modules/peerconnection/rtc_ice_candidate.cc b/third_party/blink/renderer/modules/peerconnection/rtc_ice_candidate.cc
index aa4e077724550483ceb5e08c9e7ccd457373f9ac..0b112b3eaf13e3d8eb4bbad18d767c5c5ed774a6 100644
--- a/third_party/blink/renderer/modules/peerconnection/rtc_ice_candidate.cc
+++ b/third_party/blink/renderer/modules/peerconnection/rtc_ice_candidate.cc
@@ -87,8 +87,13 @@ RTCIceCandidate::RTCIceCandidate(RTCIceCandidatePlatform* platform_candidate)
     : platform_candidate_(platform_candidate) {}
 
 String RTCIceCandidate::candidate() const {
-  return String::FromUtf8(base::android::webview::IceCandidate(
-      platform_candidate_->Candidate().Utf8()));
+  const String& original = platform_candidate_->Candidate();
+  if (!base::android::webview::Enabled()) {
+    return original;
+  }
+  std::string input = original.Utf8();
+  std::string output = base::android::webview::IceCandidate(input);
+  return output == input ? original : String::FromUtf8(output);
 }
 
 String RTCIceCandidate::sdpMid() const {
diff --git a/third_party/blink/renderer/modules/peerconnection/rtc_session_description.cc b/third_party/blink/renderer/modules/peerconnection/rtc_session_description.cc

         part.find(',', comma + 1) != std::string_view::npos ||
-        !ValidHeaderValue(part)) {
+        !std::all_of(part.begin(), part.end(),
+                     [](unsigned char c) { return c >= 32 && c <= 126; })) {
       return {};
